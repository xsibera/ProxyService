{
  "name": "Place1",
  "tree": {
    "$className": "DataModel",

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": false
      },
      "Arena": {
        "$path": "src/Workspace/Arena.model.json"
      },
      "Dummies": {
        "$path": "src/Workspace/Dummies"
      }
    },

    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "ClockTime": 14.6,
        "GeographicLatitude": 32,
        "Brightness": 3,
        "Ambient": [0.2, 0.21, 0.24],
        "OutdoorAmbient": [0.5, 0.5, 0.55],
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 1,
        "ExposureCompensation": 0.1,
        "ShadowSoftness": 0.25,
        "GlobalShadows": true
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.28,
          "Offset": 0.2,
          "Color": [0.78, 0.78, 0.82],
          "Decay": [0.42, 0.44, 0.49],
          "Glare": 0.15,
          "Haze": 1.2
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.7,
          "Size": 28,
          "Threshold": 1.4
        }
      },
      "ColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Contrast": 0.08,
          "Saturation": 0.06,
          "TintColor": [1, 0.99, 0.97]
        }
      },
      "SunRays": {
        "$className": "SunRaysEffect",
        "$properties": {
          "Intensity": 0.05,
          "Spread": 0.6
        }
      }
    },

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Combat": {
        "$path": "src/ReplicatedStorage/Combat",
        "Remotes": {
          "$className": "Folder",
          "Action": {
            "$className": "RemoteEvent"
          },
          "FX": {
            "$className": "RemoteEvent"
          }
        }
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "CombatServer": {
        "$path": "src/ServerScriptService/CombatServer"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "GameSettingsAvatar": "R6",
        "CameraMaxZoomDistance": 36,
        "CharacterWalkSpeed": 16,
        "CharacterUseJumpPower": false,
        "CharacterJumpHeight": 7.2,
        "EnableMouseLockOption": true
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "CombatClient": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/CombatClient"
        }
      },
      "StarterCharacterScripts": {
        "$className": "StarterCharacterScripts",
        "$path": "src/StarterPlayer/StarterCharacterScripts"
      }
    },

    "SoundService": {
      "$className": "SoundService"
    },

    "Players": {
      "$className": "Players"
    }
  }
}
