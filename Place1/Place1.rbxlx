    <Item class="Script" referent="19">
      <Properties>
        <string name="Name">CombatServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Fist combat server entry point.
-- Modules: CombatService (rules + networking), CharacterSetup (players, R6), DummyAI (dummies).

local CombatService = require(script.CombatService)
local CharacterSetup = require(script.CharacterSetup)
local DummyAI = require(script.DummyAI)

CombatService.Start()
CharacterSetup.Start()
DummyAI.Start()
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">CharacterSetup</string>
          <string name="Source"><![CDATA[-- Registers player characters with the combat system and guarantees they're R6.
-- The place's avatar type is set to R6, but if a character still spawns as R15 (for example
-- after copying these scripts into a place with different avatar settings) it gets rebuilt as
-- an R6 rig wearing the same avatar.

local Players = game:GetService("Players")
local StarterPlayer = game:GetService("StarterPlayer")
local Workspace = game:GetService("Workspace")

local CombatService = require(script.Parent.CombatService)

local CharacterSetup = {}

local rebuilding = {}

local function rebuildAsR6(player, character, humanoid)
	if rebuilding[player] then
		return
	end
	rebuilding[player] = true
	local ok, description = pcall(function()
		return humanoid:GetAppliedDescription()
	end)
	if not ok or not description then
		ok, description = pcall(function()
			return Players:GetHumanoidDescriptionFromUserIdAsync(math.max(1, player.UserId))
		end)
	end
	local model
	if ok and description then
		local built, result = pcall(function()
			return Players:CreateHumanoidModelFromDescriptionAsync(description, Enum.HumanoidRigType.R6)
		end)
		if built then
			model = result
		else
			warn("[CharacterSetup] couldn't build an R6 rig:", result)
		end
	end
	if model and character.Parent then
		model.Name = player.Name
		local old = model:FindFirstChild("Animate")
		if old then
			old:Destroy()
		end
		for _, script in ipairs(StarterPlayer:WaitForChild("StarterCharacterScripts"):GetChildren()) do
			script:Clone().Parent = model
		end
		model:PivotTo(character:GetPivot())
		player.Character = model
		model.Parent = Workspace
		character:Destroy()
	else
		warn("[CharacterSetup] " .. player.Name .. " is not R6; set Avatar Settings > Avatar Type to R6")
	end
	rebuilding[player] = nil
end

local function onCharacter(player, character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not (humanoid and root) then
		return
	end
	if humanoid.RigType ~= Enum.HumanoidRigType.R6 then
		task.defer(rebuildAsR6, player, character, humanoid)
		return
	end
	if not character:FindFirstChild("Torso") then
		character:WaitForChild("Torso", 5)
	end
	CombatService.Register(character, { Player = player })
end

function CharacterSetup.Start()
	local function hook(player)
		player.CharacterAdded:Connect(function(character)
			onCharacter(player, character)
		end)
		if player.Character then
			task.spawn(onCharacter, player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(hook)
	for _, player in ipairs(Players:GetPlayers()) do
		hook(player)
	end
end

return CharacterSetup
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">CombatService</string>
          <string name="Source"><![CDATA[-- Server-authoritative combat: every fighter (player or dummy) runs through the same state
-- machine. Clients only *ask* to act; the server decides what happens and tells everyone.

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Combat = ReplicatedStorage:WaitForChild("Combat")
local Config = require(Combat.Config)
local Util = require(Combat.Util)
local Remotes = Combat:WaitForChild("Remotes")
local ActionRemote = Remotes:WaitForChild("Action")
local FXRemote = Remotes:WaitForChild("FX")

local create = Util.create
local flat = Util.flat

local CombatService = {}

local fighters = {} -- [Model] = fighter
CombatService.Fighters = fighters

local QUEUE_WINDOW = 0.3 -- requests this early are queued instead of rejected
local MAX_POSTURE = Config.Block.MaxPosture
local HITS = Config.M1.Hits

local attackListeners, resultListeners = {}, {}

-- fn(fighter, kind, spec, index) whenever an attack starts (dummies use this to react)
function CombatService.OnAttackStarted(fn)
	table.insert(attackListeners, fn)
end

-- fn(result, attacker, victim) after every resolved attack: "Hit" | "Blocked" | "Parry" | ...
function CombatService.OnResult(fn)
	table.insert(resultListeners, fn)
end

local function broadcast(kind, data)
	FXRemote:FireAllClients(kind, data)
end

local function emit(list, ...)
	for _, fn in ipairs(list) do
		task.spawn(fn, ...)
	end
end

----------------------------------------------------------------------------------------------
-- Registration

local function fighterFromPart(part)
	local node = part.Parent
	while node and node ~= Workspace do
		local f = fighters[node]
		if f then
			return f
		end
		node = node.Parent
	end
	return nil
end

function CombatService.Get(model)
	return fighters[model]
end

function CombatService.Register(model, opts)
	opts = opts or {}
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root) then
		return nil
	end
	local f = {
		Model = model,
		Humanoid = humanoid,
		Root = root,
		Player = opts.Player,
		IsDummy = opts.IsDummy == true,
		Dead = false,
		State = "Idle",

		Action = nil, -- "M1" | "Heavy"
		ActionToken = 0,
		ActionEnd = 0,
		HitTime = 0,
		Queued = nil,

		Combo = 0,
		LastM1End = -math.huge,
		ComboCooldownUntil = 0,
		HeavyCooldownUntil = 0,

		Blocking = false,
		WantsBlock = false,
		BlockPressTime = -math.huge,
		BlockStart = 0,
		ParryEligible = false,
		LastParryAttempt = -math.huge,

		StunUntil = 0,
		StunKind = nil, -- "Stunned" | "Parried" | "GuardBroken"

		Posture = MAX_POSTURE,
		PostureSent = MAX_POSTURE,
		LastPostureDamage = -math.huge,

		DodgeCooldownUntil = 0,
		DodgingUntil = 0,
		IFramesUntil = 0,

		Sliding = false,
		SlideUntil = 0,

		LastHitTime = -math.huge,
	}
	fighters[model] = f

	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	model:SetAttribute("CombatState", "Idle")
	model:SetAttribute("Posture", MAX_POSTURE)
	model:SetAttribute("MaxPosture", MAX_POSTURE)
	model:SetAttribute("AttackKind", nil)
	CollectionService:AddTag(model, "Combatant")

	humanoid.Died:Connect(function()
		f.Dead = true
		f.Blocking = false
		f.Action = nil
		model:SetAttribute("CombatState", "Dead")
	end)
	model.Destroying:Connect(function()
		fighters[model] = nil
	end)
	model.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			fighters[model] = nil
		end
	end)
	return f
end

----------------------------------------------------------------------------------------------
-- Helpers

local function now()
	return os.clock()
end

local function isStunned(f, t)
	return t < f.StunUntil
end

-- Free to start a new action right now?
local function canAct(f, t)
	return not f.Dead and not isStunned(f, t) and t >= f.ActionEnd
end

local function reject(f, action, seq)
	if f.Player then
		FXRemote:FireClient(f.Player, "Reject", { Action = action, Seq = seq })
	end
end

local function cancelAction(f)
	if f.Action then
		f.ActionToken += 1
		f.Action = nil
		f.ActionEnd = 0
		broadcast("Cancel", { Model = f.Model })
	end
	f.Queued = nil
end

local function endBlock(f)
	if f.Blocking then
		f.Blocking = false
		broadcast("BlockEnd", { Model = f.Model })
	end
end

local function endSlide(f)
	if f.Sliding then
		f.Sliding = false
		broadcast("Slide", { Model = f.Model, Active = false })
	end
end

-- Pushes a server-owned body (dummies). Player characters are pushed by their own client,
-- which receives the knockback vector in the FX event.
local function physicsPush(f, velocity, duration)
	if f.Player or not f.Root.Parent then
		return
	end
	local attachment = f.Root:FindFirstChild("RootAttachment")
		or create("Attachment", { Name = "RootAttachment", Parent = f.Root })
	local old = f.Root:FindFirstChild("KnockbackVelocity")
	if old then
		old:Destroy()
	end
	local lv = create("LinearVelocity", {
		Name = "KnockbackVelocity",
		Attachment0 = attachment,
		VelocityConstraintMode = Enum.VelocityConstraintMode.Vector,
		VectorVelocity = velocity,
		MaxForce = 1e6,
		RelativeTo = Enum.ActuatorRelativeTo.World,
		Parent = f.Root,
	})
	Debris:AddItem(lv, duration)
end
CombatService.Push = physicsPush

local function isFacing(victim, attacker)
	local toAttacker = flat(attacker.Root.Position - victim.Root.Position)
	if toAttacker.Magnitude < 0.05 then
		return true
	end
	local look = flat(victim.Root.CFrame.LookVector)
	if look.Magnitude < 0.05 then
		return true
	end
	return look.Unit:Dot(toAttacker.Unit) >= Config.Block.FacingDot
end

local function stun(f, duration, kind)
	local t = now()
	f.StunUntil = math.max(f.StunUntil, t + duration)
	f.StunKind = kind
end

----------------------------------------------------------------------------------------------
-- Resolution

local function applyGuardBreak(attacker, victim, spec, dir, contact, t)
	cancelAction(victim)
	endSlide(victim)
	victim.Blocking = false
	victim.WantsBlock = false
	victim.Posture = 0
	victim.LastPostureDamage = t
	stun(victim, Config.GuardBreak.Stun, "GuardBroken")
	local damage = if spec.GuardBreak then spec.Damage * 0.35 else 0
	if damage > 0 then
		victim.Humanoid:TakeDamage(damage)
	end
	physicsPush(victim, dir * 18, 0.12)
	broadcast("GuardBreak", {
		Attacker = attacker.Model,
		Victim = victim.Model,
		Position = contact,
		Direction = dir,
		Damage = damage,
		Stun = Config.GuardBreak.Stun,
		Knockback = dir * 18,
	})
	emit(resultListeners, "GuardBreak", attacker, victim)
end

local function resolve(attacker, victim, kind, index, spec)
	local t = now()
	local delta = flat(victim.Root.Position - attacker.Root.Position)
	local dir = if delta.Magnitude > 0.05 then delta.Unit else flat(attacker.Root.CFrame.LookVector).Unit
	local contact = victim.Root.Position - dir * 0.9 + Vector3.new(0, 0.7, 0)

	-- Dodge i-frames
	if t < victim.IFramesUntil then
		broadcast("Dodged", { Attacker = attacker.Model, Victim = victim.Model, Position = contact })
		emit(resultListeners, "Dodged", attacker, victim)
		return "Dodged"
	end

	local facing = isFacing(victim, attacker)
	if victim.Blocking and facing then
		-- Parry: the first moments of a fresh block
		if victim.ParryEligible and (t - victim.BlockStart) <= Config.Parry.Window then
			cancelAction(attacker)
			endSlide(attacker)
			attacker.Combo = 0
			stun(attacker, Config.Parry.AttackerStun, "Parried")
			physicsPush(attacker, -dir * Config.Parry.AttackerPushback, 0.12)
			victim.Posture = math.min(MAX_POSTURE, victim.Posture + Config.Parry.PostureRestore)
			victim.LastParryAttempt = -math.huge -- a successful parry never locks you out
			victim.BlockStart = t -- and keeps the window open for a follow-up hit
			broadcast("Parry", {
				Attacker = attacker.Model,
				Victim = victim.Model,
				Position = contact,
				Direction = dir,
				Stun = Config.Parry.AttackerStun,
				Knockback = -dir * Config.Parry.AttackerPushback,
			})
			emit(resultListeners, "Parry", attacker, victim)
			return "Parry"
		end

		if spec.GuardBreak then
			applyGuardBreak(attacker, victim, spec, dir, contact, t)
			return "GuardBreak"
		end

		victim.Posture -= spec.PostureDamage
		victim.LastPostureDamage = t
		if victim.Posture <= 0 then
			applyGuardBreak(attacker, victim, spec, dir, contact, t)
			return "GuardBreak"
		end
		local chip = spec.Damage * Config.Block.DamageMultiplier
		if chip > 0 then
			victim.Humanoid:TakeDamage(chip)
		end
		local push = dir * Config.Block.BlockedPushback
		physicsPush(victim, push, 0.1)
		broadcast("Blocked", {
			Attacker = attacker.Model,
			Victim = victim.Model,
			Position = contact,
			Direction = dir,
			Posture = victim.Posture / MAX_POSTURE,
			Damage = chip,
			Knockback = push,
		})
		emit(resultListeners, "Blocked", attacker, victim)
		return "Blocked"
	end

	-- Clean hit
	cancelAction(victim)
	endBlock(victim)
	endSlide(victim)
	victim.Combo = 0
	victim.LastHitTime = t
	victim.Humanoid:TakeDamage(spec.Damage)
	stun(victim, spec.Stun, "Stunned")
	local knock = dir * spec.Knockback + Vector3.new(0, spec.KnockUp or 0, 0)
	local knockTime = if spec.KnockUp then 0.22 else 0.12
	physicsPush(victim, knock, knockTime)
	broadcast("Hit", {
		Attacker = attacker.Model,
		Victim = victim.Model,
		Kind = kind,
		Index = index,
		Damage = spec.Damage,
		Position = contact,
		Direction = dir,
		Finisher = spec.Finisher == true,
		Knockback = knock,
		KnockTime = knockTime,
		Stun = spec.Stun,
	})
	emit(resultListeners, "Hit", attacker, victim)
	return "Hit"
end

local overlapParams = OverlapParams.new()
overlapParams.FilterType = Enum.RaycastFilterType.Exclude

local function showHitbox(cf, size)
	local box = create("Part", {
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Transparency = 0.7,
		Color = Color3.fromRGB(255, 60, 60),
		Material = Enum.Material.ForceField,
		CFrame = cf,
		Size = size,
		Parent = Workspace,
	})
	Debris:AddItem(box, 0.25)
end

local function performHit(f, kind, index, spec)
	if f.Dead or not f.Root.Parent then
		return
	end
	local hitbox = if kind == "Heavy" then Config.Heavy.Hitbox else Config.M1.Hitbox
	local cf = f.Root.CFrame * hitbox.Offset
	overlapParams.FilterDescendantsInstances = { f.Model }
	local parts = Workspace:GetPartBoundsInBox(cf, hitbox.Size, overlapParams)
	if Config.Debug.ShowHitboxes then
		showHitbox(cf, hitbox.Size)
	end
	local seen = {}
	for _, part in ipairs(parts) do
		local target = fighterFromPart(part)
		if target and target ~= f and not seen[target] and not target.Dead then
			seen[target] = true
			resolve(f, target, kind, index, spec)
		end
	end
end

----------------------------------------------------------------------------------------------
-- Actions

local function startAttack(f, kind, index, spec, seq)
	local t = now()
	f.ActionToken += 1
	local token = f.ActionToken
	f.Action = kind
	f.ActionEnd = t + spec.Duration
	f.HitTime = t + spec.Windup
	endSlide(f)
	f.Model:SetAttribute("AttackKind", kind)
	broadcast("Attack", { Model = f.Model, Kind = kind, Index = index, Anim = spec.Anim, Seq = seq })
	emit(attackListeners, f, kind, spec, index)

	if f.IsDummy and spec.Lunge then
		local look = flat(f.Root.CFrame.LookVector)
		if look.Magnitude > 0.01 then
			task.delay(spec.Windup * 0.3, function()
				if f.ActionToken == token then
					physicsPush(f, look.Unit * spec.Lunge, spec.Windup * 0.7)
				end
			end)
		end
	end

	task.delay(spec.Windup, function()
		if f.ActionToken == token and not f.Dead and not isStunned(f, now()) then
			performHit(f, kind, index, spec)
		end
	end)
	task.delay(spec.Duration, function()
		if f.ActionToken == token then
			f.Action = nil
		end
	end)
end

local tryM1, tryHeavy

local function queue(f, kind, seq, at)
	if f.Queued then
		return
	end
	local entry = { Kind = kind, Seq = seq }
	f.Queued = entry
	task.delay(math.max(0, at - now()) + 0.001, function()
		if f.Queued == entry then
			f.Queued = nil
			if kind == "M1" then
				tryM1(f, seq)
			else
				tryHeavy(f, seq)
			end
		end
	end)
end

function tryM1(f, seq)
	local t = now()
	if f.Dead or isStunned(f, t) or f.Blocking then
		return reject(f, "M1", seq)
	end
	local readyAt = math.max(f.ActionEnd, f.ComboCooldownUntil)
	if t < readyAt then
		if readyAt - t <= QUEUE_WINDOW then
			return queue(f, "M1", seq, readyAt)
		end
		return reject(f, "M1", seq)
	end
	if t - f.LastM1End > Config.M1.ComboResetTime then
		f.Combo = 0
	end
	f.Combo = f.Combo % #HITS + 1
	local index = f.Combo
	local spec = HITS[index]
	startAttack(f, "M1", index, spec, seq)
	f.LastM1End = t + spec.Duration
	if index == #HITS then
		f.Combo = 0
		f.ComboCooldownUntil = t + spec.Duration + Config.M1.ComboEndCooldown
	end
end

function tryHeavy(f, seq)
	local t = now()
	if f.Dead or isStunned(f, t) or f.Blocking or t < f.HeavyCooldownUntil then
		return reject(f, "Heavy", seq)
	end
	if t < f.ActionEnd then
		if f.ActionEnd - t <= QUEUE_WINDOW then
			return queue(f, "Heavy", seq, f.ActionEnd)
		end
		return reject(f, "Heavy", seq)
	end
	f.Combo = 0
	f.HeavyCooldownUntil = t + Config.Heavy.Cooldown
	startAttack(f, "Heavy", 1, Config.Heavy, seq)
end

local function startBlock(f, t)
	f.Blocking = true
	f.BlockStart = t
	local fresh = (t - f.BlockPressTime) <= 0.25
	f.ParryEligible = fresh and (t - f.LastParryAttempt) >= Config.Parry.Cooldown
	if f.ParryEligible then
		f.LastParryAttempt = t
	end
	endSlide(f)
	broadcast("BlockStart", { Model = f.Model, Parry = f.ParryEligible })
end

local function tryBlockStart(f)
	local t = now()
	f.WantsBlock = true
	f.BlockPressTime = t
	if not f.Blocking and canAct(f, t) and t >= f.DodgingUntil then
		startBlock(f, t)
	end
end

local function tryBlockEnd(f)
	f.WantsBlock = false
	endBlock(f)
end

local DODGE_DIRS = { Forward = true, Back = true, Left = true, Right = true }

local function tryDodge(f, dir, seq)
	local t = now()
	if not DODGE_DIRS[dir] then
		return reject(f, "Dodge", seq)
	end
	if f.Dead or isStunned(f, t) or t < f.DodgeCooldownUntil then
		return reject(f, "Dodge", seq)
	end
	if f.Action then
		-- you can dodge out of a punch's recovery, never out of its windup
		if not Config.Dodge.CanCancelRecovery or t < f.HitTime then
			return reject(f, "Dodge", seq)
		end
		cancelAction(f)
	end
	f.WantsBlock = false
	endBlock(f)
	endSlide(f)
	f.DodgeCooldownUntil = t + Config.Dodge.Cooldown
	f.DodgingUntil = t + Config.Dodge.Duration
	f.IFramesUntil = t + Config.Dodge.IFrames + 0.06 -- small allowance for latency
	broadcast("Dodge", { Model = f.Model, Dir = dir, Seq = seq })
end

local function trySlide(f, active)
	local t = now()
	if active then
		if f.Dead or isStunned(f, t) or f.Action or f.Blocking then
			return reject(f, "Slide", nil)
		end
		f.Sliding = true
		f.SlideUntil = t + Config.Slide.MaxDuration + 0.3
		broadcast("Slide", { Model = f.Model, Active = true })
	else
		endSlide(f)
	end
end

CombatService.TryM1 = tryM1
CombatService.TryHeavy = tryHeavy
CombatService.TryBlockStart = tryBlockStart
CombatService.TryBlockEnd = tryBlockEnd
CombatService.TryDodge = tryDodge
CombatService.TrySlide = trySlide

----------------------------------------------------------------------------------------------
-- Networking

local rate = {} -- [Player] = { window = time, count = n }

local function allowRequest(player)
	local t = now()
	local r = rate[player]
	if not r or t - r.window > 1 then
		r = { window = t, count = 0 }
		rate[player] = r
	end
	r.count += 1
	return r.count <= 40
end

local function onAction(player, action, payload)
	if type(action) ~= "string" or not allowRequest(player) then
		return
	end
	local character = player.Character
	local f = character and fighters[character]
	if not f then
		return
	end
	payload = if type(payload) == "table" then payload else {}
	local seq = if type(payload.Seq) == "number" then payload.Seq else nil
	if action == "M1" then
		tryM1(f, seq)
	elseif action == "Heavy" then
		tryHeavy(f, seq)
	elseif action == "BlockStart" then
		tryBlockStart(f)
	elseif action == "BlockEnd" then
		tryBlockEnd(f)
	elseif action == "Dodge" then
		tryDodge(f, if type(payload.Dir) == "string" then payload.Dir else "", seq)
	elseif action == "Slide" then
		trySlide(f, payload.Active == true)
	end
end

----------------------------------------------------------------------------------------------
-- Per-frame upkeep

local function computeState(f, t)
	if f.Dead then
		return "Dead"
	end
	if t < f.StunUntil then
		return f.StunKind or "Stunned"
	end
	if f.Action and t < f.ActionEnd then
		return "Attacking"
	end
	if t < f.DodgingUntil then
		return "Dodging"
	end
	if f.Blocking then
		return "Blocking"
	end
	if f.Sliding then
		return "Sliding"
	end
	return "Idle"
end

local function dummySpeed(f, state)
	local m = Config.Movement
	if state == "Stunned" or state == "Parried" or state == "GuardBroken" then
		return 0
	elseif state == "Attacking" then
		return if f.Action == "Heavy" then m.HeavyWalkSpeed else m.AttackWalkSpeed
	elseif state == "Blocking" then
		return m.BlockWalkSpeed
	end
	return f.DesiredWalkSpeed or m.WalkSpeed
end

local function heartbeat(dt)
	local t = now()
	for model, f in pairs(fighters) do
		if f.Dead or not model.Parent then
			continue
		end
		if f.Action and t >= f.ActionEnd then
			f.Action = nil
		end
		if f.StunKind and t >= f.StunUntil then
			if f.StunKind == "GuardBroken" then
				f.Posture = MAX_POSTURE * Config.GuardBreak.PostureAfter
			end
			f.StunKind = nil
		end
		if f.Sliding and t >= f.SlideUntil then
			endSlide(f)
		end
		if f.WantsBlock and not f.Blocking and canAct(f, t) and t >= f.DodgingUntil then
			startBlock(f, t)
		end
		if
			f.Posture < MAX_POSTURE
			and not isStunned(f, t)
			and t - f.LastPostureDamage > Config.Block.PostureRegenDelay
		then
			f.Posture = math.min(MAX_POSTURE, f.Posture + Config.Block.PostureRegenRate * dt)
		end

		local state = computeState(f, t)
		if state ~= f.State then
			f.State = state
			model:SetAttribute("CombatState", state)
			if state ~= "Attacking" then
				model:SetAttribute("AttackKind", nil)
			end
		end
		if math.abs(f.Posture - f.PostureSent) >= 1 or (f.Posture >= MAX_POSTURE and f.PostureSent < MAX_POSTURE) then
			f.PostureSent = f.Posture
			model:SetAttribute("Posture", math.floor(f.Posture + 0.5))
		end
		if f.IsDummy then
			local speed = dummySpeed(f, state)
			if f.Humanoid.WalkSpeed ~= speed then
				f.Humanoid.WalkSpeed = speed
			end
		end
	end
end

function CombatService.Start()
	ActionRemote.OnServerEvent:Connect(onAction)
	RunService.Heartbeat:Connect(heartbeat)
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		rate[player] = nil
	end)
end

return CombatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">DummyAI</string>
          <string name="Source"><![CDATA[-- Training dummies. Each model in Workspace.Dummies has a "DummyType" attribute:
--   Bag       stands still and takes hits
--   Blocker   always holds block (break it with a heavy or by draining its posture)
--   Parrier   reads your windups and parries most attacks (practise getting parried / baiting)
--   Attacker  chases you and throws combos and heavies (practise blocking and parrying)
--   Sparring  a full sparring partner: blocks, parries, dodges and counter-attacks
-- Dummies respawn after dying and heal back up when left alone.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

local Combat = ReplicatedStorage:WaitForChild("Combat")
local Config = require(Combat.Config)
local Util = require(Combat.Util)

local CombatService = require(script.Parent.CombatService)

local create = Util.create
local flat = Util.flat

local DummyAI = {}

local DUMMY_CONFIG = Config.Dummy
local brains = {} -- [fighter] = brain

local templates
local function templateFolder()
	if not templates then
		templates = create("Folder", { Name = "DummyTemplates", Parent = ServerStorage })
	end
	return templates
end

local function nearestPlayerFighter(position, range)
	local best, bestDist = nil, range
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local f = character and CombatService.Get(character)
		if f and not f.Dead and f.Root.Parent then
			local d = (f.Root.Position - position).Magnitude
			if d < bestDist then
				best, bestDist = f, d
			end
		end
	end
	return best, bestDist
end

local function face(brain, position)
	local delta = flat(position - brain.Fighter.Root.Position)
	if delta.Magnitude > 0.1 then
		brain.Align.CFrame = CFrame.lookAt(Vector3.zero, delta.Unit)
	end
end

local function canAct(f)
	local t = os.clock()
	return not f.Dead and t >= f.StunUntil and t >= f.ActionEnd and t >= f.DodgingUntil
end

local function pressBlock(f, holdFor)
	CombatService.TryBlockStart(f)
	local token = {}
	f.BlockToken = token
	task.delay(holdFor, function()
		if f.BlockToken == token and f.Model:GetAttribute("DummyType") ~= "Blocker" then
			CombatService.TryBlockEnd(f)
		end
	end)
end

local function dodge(f, dirName)
	local root = f.Root
	local cf = root.CFrame
	local vectors = {
		Back = -cf.LookVector,
		Left = -cf.RightVector,
		Right = cf.RightVector,
		Forward = cf.LookVector,
	}
	local before = f.DodgeCooldownUntil
	CombatService.TryDodge(f, dirName, nil)
	if f.DodgeCooldownUntil ~= before then
		CombatService.Push(f, flat(vectors[dirName]).Unit * Config.Dodge.Speed * 0.8, Config.Dodge.Duration * 0.8)
		return true
	end
	return false
end

-- Throws an n-hit chain, pressing each punch as the previous one ends.
local function throwChain(brain, hits)
	local f = brain.Fighter
	brain.Busy = true
	task.spawn(function()
		for i = 1, hits do
			if f.Dead or os.clock() < f.StunUntil or brain.Dead then
				break
			end
			if brain.Target then
				face(brain, brain.Target.Root.Position)
			end
			CombatService.TryM1(f, nil)
			-- press the next punch just before this one ends (the server queues it)
			task.wait(math.max(0.05, f.ActionEnd - os.clock() - (if i == hits then 0 else 0.05)))
		end
		brain.Busy = false
		brain.NextAttack = os.clock() + 0.7 + math.random() * 0.8
	end)
end

local function throwHeavy(brain)
	local f = brain.Fighter
	if os.clock() < f.HeavyCooldownUntil then
		return false
	end
	brain.Busy = true
	CombatService.TryHeavy(f, nil)
	task.delay(Config.Heavy.Duration, function()
		brain.Busy = false
		brain.NextAttack = os.clock() + 0.9 + math.random() * 0.6
	end)
	return true
end

----------------------------------------------------------------------------------------------
-- Reactions to incoming attacks

local function attackAimedAt(attacker, f, spec)
	local delta = flat(f.Root.Position - attacker.Root.Position)
	local dist = delta.Magnitude
	if dist > 11 or dist < 0.05 then
		return false
	end
	local look = flat(attacker.Root.CFrame.LookVector)
	return look.Magnitude > 0 and look.Unit:Dot(delta.Unit) > 0.35 and spec ~= nil
end

local function schedulePerfectParry(f, spec, jitter)
	-- press so the hit lands in the middle of the parry window
	local pressIn = math.max(0, spec.Windup - Config.Parry.Window * 0.5 + (jitter or 0))
	task.delay(pressIn, function()
		if not f.Dead and os.clock() >= f.StunUntil and os.clock() >= f.ActionEnd then
			pressBlock(f, Config.Parry.Window + 0.25)
		end
	end)
end

local function onAttackStarted(attacker, _kind, spec)
	for f, brain in pairs(brains) do
		if f == attacker or f.Dead or brain.Dead or not attackAimedAt(attacker, f, spec) then
			continue
		end
		face(brain, attacker.Root.Position)
		local kindName = brain.Kind
		if kindName == "Parrier" then
			if canAct(f) and math.random() < 0.85 then
				schedulePerfectParry(f, spec, (math.random() - 0.5) * 0.04)
			end
		elseif kindName == "Sparring" then
			if canAct(f) and not brain.Busy then
				local roll = math.random()
				if roll < 0.35 then
					schedulePerfectParry(f, spec, (math.random() - 0.5) * 0.12)
				elseif roll < 0.62 then
					task.delay(0.08 + math.random() * 0.06, function()
						if canAct(f) then
							pressBlock(f, 0.9)
						end
					end)
				elseif roll < 0.78 then
					task.delay(math.max(0, spec.Windup - 0.12), function()
						if canAct(f) then
							local dirs = { "Back", "Left", "Right" }
							dodge(f, dirs[math.random(1, #dirs)])
						end
					end)
				end
			end
		end
	end
end

local function onResult(result, attacker, victim)
	-- Sparring partners punish openings: after parrying/blocking, or when you get parried.
	local brain = brains[victim]
	if brain and brain.Kind == "Sparring" and (result == "Parry" or result == "Blocked") then
		brain.CounterAt = os.clock() + (if result == "Parry" then 0.12 else 0.35)
	end
	local attackerBrain = brains[attacker]
	if attackerBrain and result == "Parry" then
		attackerBrain.NextAttack = os.clock() + Config.Parry.AttackerStun + 0.4
	end
end

----------------------------------------------------------------------------------------------
-- Brain loop

local function think(brain, dt)
	local f = brain.Fighter
	local root = f.Root
	local humanoid = f.Humanoid
	if f.Dead or not root.Parent then
		return
	end
	local t = os.clock()
	local kind = brain.Kind
	local aggressive = kind == "Attacker" or kind == "Sparring"
	local target, dist = nearestPlayerFighter(root.Position, if aggressive then DUMMY_CONFIG.AggroRange else 40)
	brain.Target = target
	local fromHome = flat(root.Position - brain.Home.Position).Magnitude

	if kind == "Blocker" and not f.WantsBlock and t >= f.StunUntil then
		CombatService.TryBlockStart(f)
	end

	if target then
		face(brain, target.Root.Position)
	else
		brain.Align.CFrame = brain.Home.Rotation
	end

	-- Movement
	local move = Vector3.zero
	if aggressive and target and fromHome < DUMMY_CONFIG.LeashRange and t >= f.StunUntil then
		local delta = flat(target.Root.Position - root.Position)
		if dist > DUMMY_CONFIG.AttackRange - 0.8 then
			move = delta.Unit
		elseif not brain.Busy then
			-- circle a little while waiting to attack
			brain.StrafeSign = brain.StrafeSign or 1
			if math.random() < dt * 0.6 then
				brain.StrafeSign = -brain.StrafeSign
			end
			move = root.CFrame.RightVector * brain.StrafeSign * 0.5
		end
		f.DesiredWalkSpeed = if dist > 12 then 18 else 13
	elseif fromHome > 1.5 then
		move = flat(brain.Home.Position - root.Position).Unit
		f.DesiredWalkSpeed = 14
	end
	humanoid:Move(move, false)

	-- Attacking
	if aggressive and target and dist <= DUMMY_CONFIG.AttackRange and canAct(f) and not brain.Busy then
		local counter = brain.CounterAt and t >= brain.CounterAt
		if counter then
			brain.CounterAt = nil
			if f.Blocking then
				CombatService.TryBlockEnd(f)
			end
			throwChain(brain, 4)
		elseif t >= (brain.NextAttack or 0) and not f.Blocking then
			local targetBlockingLong = target.Blocking and (t - target.BlockStart) > 0.9
			if (targetBlockingLong or math.random() < 0.2) and throwHeavy(brain) then
				return
			end
			throwChain(brain, if kind == "Attacker" then 4 else math.random(2, 4))
		end
	end

	-- Heal up when left alone
	if t - f.LastHitTime > DUMMY_CONFIG.RegenDelay and humanoid.Health < humanoid.MaxHealth then
		humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + humanoid.MaxHealth * 0.6 * dt)
	end
end

----------------------------------------------------------------------------------------------
-- Spawning

local function setup(model, template, folder)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root) then
		warn("[DummyAI] " .. model:GetFullName() .. " is missing a Humanoid or HumanoidRootPart")
		return
	end
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			part.Anchored = false
		end
	end
	humanoid.MaxHealth = DUMMY_CONFIG.MaxHealth
	humanoid.Health = DUMMY_CONFIG.MaxHealth
	humanoid.AutoRotate = false
	humanoid.BreakJointsOnDeath = true
	model:SetAttribute("AlwaysCombat", true)

	local f = CombatService.Register(model, { IsDummy = true })
	if not f then
		return
	end
	pcall(function()
		root:SetNetworkOwner(nil)
	end)

	local attachment = root:FindFirstChild("RootAttachment")
		or create("Attachment", { Name = "RootAttachment", Parent = root })
	local align = create("AlignOrientation", {
		Name = "FaceTarget",
		Mode = Enum.OrientationAlignmentMode.OneAttachment,
		Attachment0 = attachment,
		Responsiveness = 28,
		MaxTorque = 1e6,
		CFrame = root.CFrame.Rotation,
		Parent = root,
	})

	local brain = {
		Fighter = f,
		Kind = model:GetAttribute("DummyType") or "Bag",
		Home = root.CFrame,
		Align = align,
		Busy = false,
		NextAttack = os.clock() + 1.5,
	}
	brains[f] = brain

	humanoid.Died:Connect(function()
		brain.Dead = true
		brains[f] = nil
		task.delay(DUMMY_CONFIG.RespawnTime, function()
			model:Destroy()
			local fresh = template:Clone()
			fresh.Parent = folder
			setup(fresh, template, folder)
		end)
	end)
end

function DummyAI.Start()
	local folder = Workspace:FindFirstChild("Dummies")
	if not folder then
		warn("[DummyAI] Workspace.Dummies not found, no dummies will spawn")
		return
	end
	CombatService.OnAttackStarted(onAttackStarted)
	CombatService.OnResult(onResult)

	for _, model in ipairs(folder:GetChildren()) do
		if model:IsA("Model") then
			local template = model:Clone()
			template.Parent = templateFolder()
			setup(model, template, folder)
		end
	end

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < 0.05 then
			return
		end
		local step = accumulator
		accumulator = 0
		for _, brain in pairs(brains) do
			local ok, err = pcall(think, brain, step)
			if not ok then
				warn("[DummyAI]", err)
			end
		end
	end)
end

return DummyAI
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="23">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="24">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">36</float>
      <float name="CharacterJumpHeight">7.2</float>
      <bool name="CharacterUseJumpPower">false</bool>
      <float name="CharacterWalkSpeed">16</float>
      <bool name="EnableMouseLockOption">true</bool>
      <token name="GameSettingsAvatar">0</token>
    </Properties>
    <Item class="StarterCharacterScripts" referent="25">
      <Properties>
        <string name="Name">StarterCharacterScripts</string>
      </Properties>
      <Item class="LocalScript" referent="26">
        <Properties>
          <string name="Name">Animate</string>
          <string name="Source"><![CDATA[-- Intentionally empty.
-- A LocalScript named "Animate" in StarterCharacterScripts replaces Roblox's default R6
-- animation script. Characters are animated by ProceduralAnimator (CombatClient) instead,
-- which runs every pose at full framerate and blends combat moves with movement.
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="27">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="28">
        <Properties>
          <string name="Name">CombatClient</string>
          <string name="Source"><![CDATA[-- Fist combat client entry point.
-- Animates every combatant (ProceduralAnimator), handles input/prediction, movement, effects
-- and the HUD.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Combat = ReplicatedStorage:WaitForChild("Combat")
local Remotes = Combat:WaitForChild("Remotes")

local Animator = require(Combat:WaitForChild("ProceduralAnimator"))
local VFX = require(Combat:WaitForChild("VFX"))
local SFX = require(Combat:WaitForChild("SFX"))

local CameraFX = require(script.CameraFX)
local HUD = require(script.HUD)
local Movement = require(script.MovementController)
local CombatController = require(script.CombatController)
local FXHandler = require(script.FXHandler)

local actionRemote = Remotes:WaitForChild("Action")

local ctx = {
	Animator = Animator,
	VFX = VFX,
	SFX = SFX,
	CameraFX = CameraFX,
	HUD = HUD,
	Movement = Movement,
	CombatController = CombatController,
	FX = FXHandler,
	Remotes = { Action = actionRemote, FX = Remotes:WaitForChild("FX") },
}

function ctx.Send(action, payload)
	actionRemote:FireServer(action, payload)
end

-- Every combatant gets a procedural rig + fist trails as soon as its body exists.
local function track(model)
	task.spawn(function()
		if not (model:WaitForChild("HumanoidRootPart", 10) and model:WaitForChild("Torso", 10)) then
			return
		end
		for _, part in ipairs({ "Head", "Left Arm", "Right Arm", "Left Leg", "Right Leg" }) do
			model:WaitForChild(part, 5)
		end
		-- joints can arrive a moment after the parts
		local torso = model:FindFirstChild("Torso")
		for _, joint in ipairs({ "Neck", "Left Shoulder", "Right Shoulder", "Left Hip", "Right Hip" }) do
			torso:WaitForChild(joint, 5)
		end
		model.HumanoidRootPart:WaitForChild("RootJoint", 5)
		if model.Parent and Animator.Get(model) then
			VFX.EnsureTrails(model)
		end
	end)
end

Animator.Start()
SFX.Preload()
CameraFX.Start()
Movement.Start(ctx)
CombatController.Start(ctx)
FXHandler.Start(ctx)
HUD.Start(ctx)

for _, model in ipairs(CollectionService:GetTagged("Combatant")) do
	track(model)
end
CollectionService:GetInstanceAddedSignal("Combatant"):Connect(track)
CollectionService:GetInstanceRemovedSignal("Combatant"):Connect(function(model)
	Animator.Remove(model)
end)
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">CameraFX</string>
            <string name="Source"><![CDATA[-- Camera feel: trauma-based shake, FOV kicks, colour flashes, blur pulses and speed lines.
-- The shake offset is removed again before Roblox's camera scripts run each frame, so it
-- never drifts or fights the default camera.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Combat = ReplicatedStorage:WaitForChild("Combat")
local Config = require(Combat.Config)
local Util = require(Combat.Util)

local create = Util.create

local CameraFX = {}

local trauma = 0
local lastOffset = CFrame.identity
local fovBase = Config.Sprint.BaseFOV
local fovTarget = fovBase
local fovCurrent = fovBase
local fovKick = 0
local speedLineIntensity = 0
local seed = math.random() * 1000

local colorCorrection, blur
local flashColor, flashStrength, flashDecay = Color3.new(1, 1, 1), 0, 6
local blurStrength, blurDecay = 0, 8

local function effects()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	if not colorCorrection or colorCorrection.Parent ~= camera then
		colorCorrection = create("ColorCorrectionEffect", { Name = "CombatFlash", Parent = camera })
		blur = create("BlurEffect", { Name = "CombatBlur", Size = 0, Parent = camera })
	end
end

function CameraFX.Shake(amount)
	trauma = math.min(1, trauma + amount)
end

function CameraFX.Kick(fovDelta)
	fovKick += fovDelta
end

function CameraFX.SetFOV(target)
	fovTarget = target
end

function CameraFX.Flash(color, strength, decay)
	flashColor = color
	flashStrength = math.max(flashStrength, strength)
	flashDecay = decay or 6
end

function CameraFX.Blur(size, decay)
	blurStrength = math.max(blurStrength, size)
	blurDecay = decay or 8
end

function CameraFX.SetSpeedLines(intensity)
	speedLineIntensity = math.clamp(intensity, 0, 1)
end

----------------------------------------------------------------------------------------------
-- Speed lines (screen-space, pooled)

local linesGui, linesFrame
local pool, active = {}, {}

local function ensureLines()
	if linesGui and linesGui.Parent then
		return
	end
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	linesGui = create("ScreenGui", {
		Name = "SpeedLines",
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		DisplayOrder = -5,
		Parent = playerGui,
	})
	linesFrame = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = linesGui,
	})
end

local function spawnLine()
	local line = table.remove(pool)
	if not line then
		line = create("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			Parent = linesFrame,
		})
		create("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.35, 0.15),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = line,
		})
	end
	local size = linesFrame.AbsoluteSize
	local half = size / 2
	local angle = math.random() * math.pi * 2
	local dir = Vector2.new(math.cos(angle), math.sin(angle))
	local radius = math.max(half.X, half.Y) * (0.55 + math.random() * 0.25)
	local data = {
		Frame = line,
		Dir = dir,
		Radius = radius,
		Length = 80 + math.random() * 160,
		Thickness = 1 + math.random() * 2,
		Age = 0,
		Life = 0.16 + math.random() * 0.1,
		Center = half,
	}
	line.Rotation = math.deg(angle)
	line.Visible = true
	table.insert(active, data)
end

local function updateLines(dt)
	if speedLineIntensity > 0.01 then
		ensureLines()
		local count = speedLineIntensity * 70 * dt
		while count > 0 do
			if math.random() < count then
				spawnLine()
			end
			count -= 1
		end
	end
	for i = #active, 1, -1 do
		local d = active[i]
		d.Age += dt
		local a = d.Age / d.Life
		if a >= 1 then
			d.Frame.Visible = false
			table.insert(pool, d.Frame)
			table.remove(active, i)
		else
			local r = d.Radius + a * d.Length * 1.5
			local pos = d.Center + d.Dir * r
			d.Frame.Position = UDim2.fromOffset(pos.X, pos.Y)
			d.Frame.Size = UDim2.fromOffset(d.Length, d.Thickness)
			d.Frame.BackgroundTransparency = 0.25 + 0.75 * a
		end
	end
end

----------------------------------------------------------------------------------------------

function CameraFX.Start()
	-- 1) remove last frame's shake before the default camera reads its CFrame
	RunService:BindToRenderStep("CombatCameraFX_Undo", Enum.RenderPriority.Camera.Value - 1, function()
		local camera = Workspace.CurrentCamera
		if camera and lastOffset ~= CFrame.identity then
			camera.CFrame = camera.CFrame * lastOffset:Inverse()
			lastOffset = CFrame.identity
		end
	end)

	-- 2) apply this frame's shake + FOV after the default camera has updated
	RunService:BindToRenderStep("CombatCameraFX", Enum.RenderPriority.Camera.Value + 1, function(dt)
		local camera = Workspace.CurrentCamera
		if not camera then
			return
		end
		effects()
		local t = os.clock()
		trauma = math.max(0, trauma - dt * 1.6)
		local shake = trauma * trauma
		if shake > 0.0005 then
			local freq = 22
			local ax = math.noise(seed, t * freq) * math.rad(2.6) * shake
			local ay = math.noise(seed + 10, t * freq) * math.rad(2.6) * shake
			local az = math.noise(seed + 20, t * freq) * math.rad(3.2) * shake
			local ox = math.noise(seed + 30, t * freq) * 0.35 * shake
			local oy = math.noise(seed + 40, t * freq) * 0.35 * shake
			lastOffset = CFrame.new(ox, oy, 0) * CFrame.Angles(ax, ay, az)
			camera.CFrame = camera.CFrame * lastOffset
		end

		fovKick += (0 - fovKick) * (1 - math.exp(-9 * dt))
		fovCurrent += (fovTarget - fovCurrent) * (1 - math.exp(-6 * dt))
		camera.FieldOfView = math.clamp(fovCurrent + fovKick, 40, 110)

		if colorCorrection then
			flashStrength = math.max(0, flashStrength - flashStrength * flashDecay * dt - 0.01 * dt)
			colorCorrection.TintColor = Color3.new(1, 1, 1):Lerp(flashColor, math.min(1, flashStrength))
			colorCorrection.Brightness = flashStrength * 0.25
			colorCorrection.Contrast = flashStrength * 0.25
			colorCorrection.Saturation = -flashStrength * 0.2
			blurStrength = math.max(0, blurStrength - blurStrength * blurDecay * dt - 0.1 * dt)
			blur.Size = blurStrength
		end

		updateLines(dt)
	end)
end

return CameraFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">CombatController</string>
            <string name="Source"><![CDATA[-- Local combat input + prediction.
--
-- Pressing a button plays the animation, swing sound and lunge immediately (prediction) and
-- asks the server. The server echoes the action with the same sequence number; if it
-- disagrees (different combo index) we correct, and if it rejects we roll back.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Combat = ReplicatedStorage:WaitForChild("Combat")
local Config = require(Combat.Config)

local CombatController = {}

local player = Players.LocalPlayer
local ctx

local HITS = Config.M1.Hits
local ATTACK_CLIPS = { "Jab", "Cross", "Hook", "Uppercut", "Heavy" }

local s = {
	Seq = 0,
	Combo = 0,
	LastM1End = -math.huge,
	ComboCooldownUntil = 0,
	ActionEnd = 0,
	HitTime = 0,
	ActionKind = nil,
	ActionSeq = nil,
	HeavyCooldownUntil = 0,
	DodgeCooldownUntil = 0,
	BlockHeld = false,
	Blocking = false,
	M1Held = false,
	BufferedAction = nil,
	BufferedAt = 0,
	Predicted = {},
}
CombatController.State = s

local function character()
	return player.Character
end

local function rig()
	local c = character()
	return c and ctx.Animator.Get(c)
end

local function combatState()
	local c = character()
	return c and c:GetAttribute("CombatState") or "Idle"
end

local function stunned()
	local state = combatState()
	return state == "Stunned" or state == "Parried" or state == "GuardBroken" or state == "Dead"
end

local function alive()
	local c = character()
	local humanoid = c and c:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0
end

function CombatController.IsAttacking()
	return os.clock() < s.ActionEnd
end

function CombatController.AttackKind()
	return s.ActionKind
end

function CombatController.IsBlocking()
	return s.Blocking
end

function CombatController.IsBusy()
	return os.clock() < s.ActionEnd or s.Blocking
end

----------------------------------------------------------------------------------------------
-- Prediction

local function nextSeq()
	s.Seq += 1
	return s.Seq
end

local function beginAttack(kind, index, spec)
	local t = os.clock()
	local seq = nextSeq()
	s.ActionKind = kind
	s.ActionSeq = seq
	s.ActionEnd = t + spec.Duration
	s.HitTime = t + spec.Windup
	s.Predicted[seq] = { Kind = kind, Index = index, Anim = spec.Anim }
	ctx.Movement.StopSlide()
	ctx.Movement.AimAssist()
	local r = rig()
	if r then
		r:Play(spec.Anim)
	end
	ctx.Movement.Lunge(spec.Lunge, spec.Windup + 0.05)
	ctx.Send(kind, { Seq = seq })
end

local function tryM1()
	if not alive() or stunned() or s.Blocking or ctx.Movement.IsDodging() then
		return false
	end
	local t = os.clock()
	local readyAt = math.max(s.ActionEnd, s.ComboCooldownUntil)
	if t < readyAt then
		if readyAt - t <= Config.M1.InputBuffer then
			s.BufferedAction, s.BufferedAt = "M1", readyAt
		end
		return false
	end
	if t - s.LastM1End > Config.M1.ComboResetTime then
		s.Combo = 0
	end
	s.Combo = s.Combo % #HITS + 1
	local index = s.Combo
	local spec = HITS[index]
	beginAttack("M1", index, spec)
	s.LastM1End = t + spec.Duration
	if index == #HITS then
		s.Combo = 0
		s.ComboCooldownUntil = t + spec.Duration + Config.M1.ComboEndCooldown
	end
	return true
end

local function tryHeavy()
	if not alive() or stunned() or s.Blocking or ctx.Movement.IsDodging() then
		return false
	end
	local t = os.clock()
	if t < s.HeavyCooldownUntil then
		return false
	end
	if t < s.ActionEnd then
		if s.ActionEnd - t <= Config.M1.InputBuffer then
			s.BufferedAction, s.BufferedAt = "Heavy", s.ActionEnd
		end
		return false
	end
	s.Combo = 0
	s.HeavyCooldownUntil = t + Config.Heavy.Cooldown
	beginAttack("Heavy", 1, Config.Heavy)
	return true
end

local function startBlockVisual()
	if s.Blocking then
		return
	end
	s.Blocking = true
	ctx.Movement.StopSlide()
	ctx.Movement.StopSprint()
	local r = rig()
	if r then
		r:Play("BlockHold")
	end
end

local function stopBlockVisual()
	if not s.Blocking then
		return
	end
	s.Blocking = false
	local r = rig()
	if r then
		r:Stop("BlockHold")
	end
end

local function canBlockNow()
	return alive() and not stunned() and os.clock() >= s.ActionEnd and not ctx.Movement.IsDodging()
end

local function blockPressed()
	s.BlockHeld = true
	ctx.Send("BlockStart")
	if canBlockNow() then
		startBlockVisual()
	end
end

local function blockReleased()
	s.BlockHeld = false
	ctx.Send("BlockEnd")
	stopBlockVisual()
end

local function tryDodge()
	if not alive() or stunned() then
		return false
	end
	local t = os.clock()
	if t < s.DodgeCooldownUntil then
		return false
	end
	if t < s.ActionEnd then
		if not Config.Dodge.CanCancelRecovery or t < s.HitTime then
			return false
		end
		-- dodge-cancel the recovery of a punch
		local r = rig()
		if r and s.ActionSeq and s.Predicted[s.ActionSeq] then
			r:Stop(s.Predicted[s.ActionSeq].Anim, 0.08)
		end
		s.ActionEnd = t
	end
	local dir = ctx.Movement.DodgeDirection()
	if not ctx.Movement.Dodge(dir) then
		return false
	end
	stopBlockVisual()
	s.DodgeCooldownUntil = t + Config.Dodge.Cooldown
	local seq = nextSeq()
	s.Predicted[seq] = { Kind = "Dodge", Dir = dir }
	local c = character()
	ctx.FX.PlayDodge(c, dir)
	ctx.Send("Dodge", { Dir = dir, Seq = seq })
	return true
end

----------------------------------------------------------------------------------------------
-- Server reconciliation (called by FXHandler for events about our own character)

function CombatController.OnOwnAttack(data)
	local predicted = data.Seq and s.Predicted[data.Seq]
	if predicted and predicted.Index == data.Index then
		return true -- already playing
	end
	-- server picked a different hit (or it was queued server-side): follow the server
	local spec = if data.Kind == "Heavy" then Config.Heavy else HITS[data.Index]
	if spec then
		local t = os.clock()
		local r = rig()
		if r then
			for _, name in ipairs(ATTACK_CLIPS) do
				if name ~= spec.Anim then
					r:Stop(name, 0.05)
				end
			end
			r:Play(spec.Anim)
		end
		s.ActionKind = data.Kind
		s.ActionEnd = t + spec.Duration
		s.HitTime = t + spec.Windup
		if data.Kind == "M1" then
			s.Combo = if data.Index >= #HITS then 0 else data.Index
			s.LastM1End = t + spec.Duration
		end
	end
	return true
end

function CombatController.OnReject(data)
	local predicted = data.Seq and s.Predicted[data.Seq]
	if not predicted then
		return
	end
	local r = rig()
	if predicted.Kind == "M1" or predicted.Kind == "Heavy" then
		if r then
			r:Stop(predicted.Anim, 0.08)
		end
		if s.ActionSeq == data.Seq then
			s.ActionEnd = 0
			s.ActionKind = nil
		end
		s.Combo = 0
		if predicted.Kind == "Heavy" then
			s.HeavyCooldownUntil = 0
		end
	end
	s.Predicted[data.Seq] = nil
end

-- Our action got interrupted (hit, parried, guard broken).
function CombatController.OnInterrupted(releaseBlock)
	s.ActionEnd = 0
	s.ActionKind = nil
	s.BufferedAction = nil
	s.Combo = 0
	stopBlockVisual()
	if releaseBlock then
		s.BlockHeld = false
	end
	local r = rig()
	if r then
		for _, name in ipairs(ATTACK_CLIPS) do
			r:Stop(name, 0.06)
		end
	end
end

function CombatController.OnServerBlock(active)
	if active and s.BlockHeld then
		startBlockVisual()
	elseif not active then
		stopBlockVisual()
	end
end

----------------------------------------------------------------------------------------------
-- Input

local function bind(name, fn, touchTitle, position, ...)
	ContextActionService:BindAction(name, fn, touchTitle ~= nil, ...)
	if touchTitle then
		ContextActionService:SetTitle(name, touchTitle)
		ContextActionService:SetPosition(name, position)
	end
end

local function onAttack(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		s.M1Held = true
		tryM1()
	elseif inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
		s.M1Held = false
	end
	return Enum.ContextActionResult.Pass
end

local function onBlock(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		blockPressed()
	elseif inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
		blockReleased()
	end
	return Enum.ContextActionResult.Sink
end

local function onHeavy(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		tryHeavy()
	end
	return Enum.ContextActionResult.Sink
end

local function onDodge(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		tryDodge()
	end
	return Enum.ContextActionResult.Sink
end

local function onSlide(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		ctx.Movement.TrySlide()
	end
	return Enum.ContextActionResult.Sink
end

local function onSprint(_, inputState, input)
	local toggle = input.KeyCode == Config.Keybinds.GamepadSprint or input.UserInputType == Enum.UserInputType.Touch
	if toggle then
		if inputState == Enum.UserInputState.Begin then
			ctx.Movement.ToggleSprint()
		end
	elseif inputState == Enum.UserInputState.Begin then
		ctx.Movement.SetSprintHeld(true)
	elseif inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
		ctx.Movement.SetSprintHeld(false)
	end
	return Enum.ContextActionResult.Sink
end

local function onHelp(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		ctx.HUD.ToggleHelp()
	end
	return Enum.ContextActionResult.Sink
end

function CombatController.Start(context)
	ctx = context
	local k = Config.Keybinds
	bind("CombatAttack", onAttack, "Punch", UDim2.new(1, -95, 0, 10), k.Attack, k.GamepadAttack)
	bind("CombatBlock", onBlock, "Block", UDim2.new(1, -170, 0, 10), k.Block, k.GamepadBlock)
	bind("CombatHeavy", onHeavy, "Heavy", UDim2.new(1, -95, 0, -65), k.Heavy, k.GamepadHeavy)
	bind("CombatDodge", onDodge, "Dodge", UDim2.new(1, -170, 0, -65), k.Dodge, k.GamepadDodge)
	bind("CombatSlide", onSlide, "Slide", UDim2.new(1, -245, 0, 10), k.Slide, k.GamepadSlide)
	bind("CombatSprint", onSprint, "Sprint", UDim2.new(1, -245, 0, -65), k.SprintHold, k.GamepadSprint)
	bind("CombatHelp", onHelp, nil, nil, Enum.KeyCode.H)

	-- buffered presses + hold-to-chain
	RunService.Heartbeat:Connect(function()
		local t = os.clock()
		if s.BufferedAction and t >= s.BufferedAt then
			local action = s.BufferedAction
			s.BufferedAction = nil
			if action == "M1" then
				tryM1()
			else
				tryHeavy()
			end
		elseif s.M1Held and t >= math.max(s.ActionEnd, s.ComboCooldownUntil) and not s.Blocking then
			tryM1()
		end
		if s.ActionKind and t >= s.ActionEnd then
			s.ActionKind = nil
		end
		-- a held block starts as soon as we're free (after a punch, a stun, a dodge)
		if s.BlockHeld and not s.Blocking and canBlockNow() then
			startBlockVisual()
		end
		-- forget old predictions
		for seq in pairs(s.Predicted) do
			if seq < s.Seq - 40 then
				s.Predicted[seq] = nil
			end
		end
	end)

	player.CharacterAdded:Connect(function()
		s.ActionEnd, s.ActionKind, s.Combo = 0, nil, 0
		s.Blocking, s.BlockHeld, s.M1Held, s.BufferedAction = false, false, false, nil
		s.HeavyCooldownUntil, s.DodgeCooldownUntil = 0, 0
	end)
end

return CombatController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">FXHandler</string>
            <string name="Source"><![CDATA[-- Turns server combat events into animation, hitstop, VFX, SFX and camera feedback for every
-- character in the game.

local Players = game:GetService("Players")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Combat = ReplicatedStorage:WaitForChild("Combat")
local Config = require(Combat.Config)

local FXHandler = {}

local player = Players.LocalPlayer
local ctx

local ATTACK_CLIPS = { "Jab", "Cross", "Hook", "Uppercut", "Heavy" }
local chargeStops = {} -- [Model] = stop function

local function isMe(model)
	return model ~= nil and model == player.Character
end

local function rigOf(model)
	return model and model.Parent and ctx.Animator.Get(model) or nil
end

local function stopAttacks(rig, fade)
	for _, name in ipairs(ATTACK_CLIPS) do
		rig:Stop(name, fade or 0.06)
	end
	ctx.VFX.SetTrail(rig.Model, "L", false)
	ctx.VFX.SetTrail(rig.Model, "R", false)
	local stop = chargeStops[rig.Model]
	if stop then
		chargeStops[rig.Model] = nil
		stop()
	end
end

local function hitstop(duration, ...)
	for _, model in ipairs({ ... }) do
		local rig = rigOf(model)
		if rig then
			rig:Freeze(duration)
		end
	end
end

local function rootOf(model)
	return model and model:FindFirstChild("HumanoidRootPart")
end

----------------------------------------------------------------------------------------------
-- Marker-driven effects (swings, charge, footsteps, landings)

local function onMarker(rig, track, marker)
	local model = rig.Model
	local name = marker.name
	if name == "Swing" then
		local heavy = track.Name == "Heavy"
		ctx.VFX.SetTrail(model, marker.arm or "R", true, if heavy then ctx.VFX.Palette.Heavy.Accent else nil)
		local root = rootOf(model)
		if root then
			ctx.SFX.Play(if heavy or track.Name == "Uppercut" then "SwingHeavy" else "Swing", root)
		end
	elseif name == "SwingEnd" then
		ctx.VFX.SetTrail(model, marker.arm or "R", false)
	elseif name == "Charge" then
		local old = chargeStops[model]
		if old then
			old()
		end
		chargeStops[model] = ctx.VFX.Charge(model, "R", Config.Heavy.Windup - 0.02)
		ctx.VFX.FlashModel(model, ctx.VFX.Palette.Heavy.Accent, Config.Heavy.Windup, 0.75)
		local root = rootOf(model)
		if root then
			ctx.SFX.Play("HeavyCharge", root)
		end
	elseif name == "Impact" then
		local stop = chargeStops[model]
		if stop then
			chargeStops[model] = nil
			stop()
		end
	elseif name == "Land" then
		local root = rootOf(model)
		if root then
			ctx.SFX.Play("BodySlam", root)
			ctx.VFX.Land(model, 1)
		end
	end
end

local function onLand(rig, impact)
	ctx.VFX.Land(rig.Model, impact)
	local root = rootOf(rig.Model)
	if root and impact > 0.45 then
		ctx.SFX.Play("Land", root, { Volume = 0.4 + impact * 0.6 })
	end
	if isMe(rig.Model) and impact > 0.5 then
		ctx.CameraFX.Shake(0.15 * impact)
	end
end

local function onStep(rig, runBlend)
	if runBlend > 0.5 then
		ctx.VFX.Footstep(rig.Model, runBlend)
	end
end

----------------------------------------------------------------------------------------------
-- Dodge visuals (also used directly by the local prediction)

function FXHandler.PlayDodge(model, dir)
	local rig = rigOf(model)
	if not rig then
		return
	end
	rig:Play("Dodge" .. dir)
	local root = rootOf(model)
	if not root then
		return
	end
	local vectors = {
		Forward = root.CFrame.LookVector,
		Back = -root.CFrame.LookVector,
		Left = -root.CFrame.RightVector,
		Right = root.CFrame.RightVector,
	}
	ctx.VFX.DodgeBurst(model, vectors[dir] or root.CFrame.LookVector)
	ctx.SFX.Play("Dodge", root)
	local accent = ctx.VFX.Palette.Dodge.Accent
	task.spawn(function()
		for _ = 1, 5 do
			if not model.Parent then
				break
			end
			ctx.VFX.Afterimage(model, accent, 0.28)
			task.wait(0.045)
		end
	end)
	if isMe(model) then
		ctx.CameraFX.Kick(3)
	end
end

----------------------------------------------------------------------------------------------
-- Server events

local handlers = {}

function handlers.Attack(data)
	if isMe(data.Model) then
		ctx.CombatController.OnOwnAttack(data)
		return
	end
	local rig = rigOf(data.Model)
	if rig and data.Anim then
		stopAttacks(rig, 0.04)
		rig:Play(data.Anim)
	end
end

function handlers.Cancel(data)
	local rig = rigOf(data.Model)
	if rig then
		stopAttacks(rig)
	end
end

function handlers.Hit(data)
	local attacker, victim = data.Attacker, data.Victim
	local heavy = data.Kind == "Heavy"
	local kind = if heavy then "Heavy" elseif data.Finisher then "Finisher" else "Light"
	local stopTime = if heavy
		then Config.HitStop.Heavy
		elseif data.Finisher then Config.HitStop.Finisher
		else Config.HitStop.Light
	hitstop(stopTime, attacker, victim)

	local victimRig = rigOf(victim)
	if victimRig then
		stopAttacks(victimRig)
		victimRig:Stop("BlockHold", 0.05)
		victimRig:Stop("Slide", 0.08)
		local clip
		if heavy or data.Finisher then
			clip = "Knockback"
		elseif data.Index == 3 then
			clip = "HitBody"
		else
			clip = if (data.Index or 1) % 2 == 1 then "HitA" else "HitB"
		end
		victimRig:Play(clip)
		victimRig:Shake(if heavy then 9 else 5, stopTime + 0.12)
	end

	ctx.VFX.Hit(data.Position, data.Direction, kind, victim)
	ctx.SFX.Play(if heavy then "HitHeavy" elseif data.Finisher then "HitFinisher" else "Hit", data.Position)
	if Config.Damage.ShowNumbers and data.Damage then
		ctx.VFX.DamageNumber(data.Position + Vector3.new(0, 1.2, 0), data.Damage, kind)
	end

	if isMe(attacker) then
		ctx.CameraFX.Shake(if heavy then 0.45 elseif data.Finisher then 0.32 else 0.14)
		ctx.CameraFX.Kick(if heavy then -6 else -1.5)
		ctx.HUD.RegisterHit()
		if heavy then
			ctx.CameraFX.Flash(Color3.fromRGB(255, 200, 170), 0.6, 5)
		end
	end
	if isMe(victim) then
		ctx.CombatController.OnInterrupted(false)
		ctx.Movement.ApplyKnockback(data.Knockback, data.KnockTime or 0.12)
		ctx.CameraFX.Shake(if heavy then 0.6 elseif data.Finisher then 0.45 else 0.25)
		ctx.CameraFX.Flash(Color3.fromRGB(255, 120, 120), if heavy then 0.8 else 0.35, 7)
		if heavy then
			ctx.CameraFX.Blur(10, 5)
		end
	end
end

function handlers.Blocked(data)
	hitstop(Config.HitStop.Block, data.Attacker, data.Victim)
	local victimRig = rigOf(data.Victim)
	if victimRig then
		victimRig:Play("BlockImpact")
		victimRig:Shake(2.5, 0.12)
	end
	ctx.VFX.Block(data.Position, data.Direction, data.Victim)
	ctx.SFX.Play("Block", data.Position)
	if data.Damage and data.Damage > 0 and Config.Damage.ShowNumbers then
		ctx.VFX.DamageNumber(data.Position + Vector3.new(0, 1.2, 0), data.Damage, "Chip")
	end
	if isMe(data.Victim) then
		ctx.CameraFX.Shake(0.12)
		ctx.Movement.ApplyKnockback(data.Knockback, 0.1)
		ctx.HUD.FlashPosture()
	end
	if isMe(data.Attacker) then
		ctx.CameraFX.Shake(0.08)
	end
end

function handlers.Parry(data)
	local parried, parrier = data.Attacker, data.Victim
	hitstop(Config.HitStop.Parry, parried, parrier)
	local parriedRig = rigOf(parried)
	if parriedRig then
		stopAttacks(parriedRig, 0.03)
		parriedRig:Play("Parried")
		parriedRig:Shake(6, 0.25)
	end
	local parrierRig = rigOf(parrier)
	if parrierRig then
		parrierRig:Play("ParryDeflect")
	end
	ctx.VFX.Parry(data.Position, data.Direction, parrier, parried, data.Stun)
	ctx.SFX.Play("Parry", data.Position)

	local gold = ctx.VFX.Palette.Parry.Accent
	if isMe(parrier) then
		ctx.CameraFX.Shake(0.35)
		ctx.CameraFX.Kick(-7)
		ctx.CameraFX.Flash(gold, 1, 4)
		ctx.CameraFX.Blur(8, 6)
		ctx.HUD.ParryBanner()
	end
	if isMe(parried) then
		ctx.CombatController.OnInterrupted(false)
		ctx.Movement.ApplyKnockback(data.Knockback, 0.12)
		ctx.CameraFX.Shake(0.5)
		ctx.CameraFX.Flash(gold, 0.7, 4)
		ctx.CameraFX.Blur(12, 4)
	end
end

function handlers.GuardBreak(data)
	hitstop(Config.HitStop.GuardBreak, data.Attacker, data.Victim)
	local victimRig = rigOf(data.Victim)
	if victimRig then
		stopAttacks(victimRig)
		victimRig:Stop("BlockHold", 0.03)
		victimRig:Play("GuardBroken")
		victimRig:Shake(7, 0.25)
	end
	ctx.VFX.GuardBreak(data.Position, data.Direction, data.Victim, data.Stun)
	ctx.SFX.Play("GuardBreak", data.Position)
	if data.Damage and data.Damage > 0 and Config.Damage.ShowNumbers then
		ctx.VFX.DamageNumber(data.Position + Vector3.new(0, 1.2, 0), data.Damage, "Heavy")
	end
	if isMe(data.Victim) then
		ctx.CombatController.OnInterrupted(true)
		ctx.Movement.ApplyKnockback(data.Knockback, 0.12)
		ctx.CameraFX.Shake(0.5)
		ctx.CameraFX.Flash(ctx.VFX.Palette.GuardBreak.Accent, 0.8, 4)
	end
	if isMe(data.Attacker) then
		ctx.CameraFX.Shake(0.3)
		ctx.CameraFX.Kick(-4)
	end
end

function handlers.BlockStart(data)
	if isMe(data.Model) then
		ctx.CombatController.OnServerBlock(true)
		return
	end
	local rig = rigOf(data.Model)
	if rig then
		rig:Play("BlockHold")
	end
end

function handlers.BlockEnd(data)
	if isMe(data.Model) then
		ctx.CombatController.OnServerBlock(false)
		return
	end
	local rig = rigOf(data.Model)
	if rig then
		rig:Stop("BlockHold")
	end
end

function handlers.Dodge(data)
	if isMe(data.Model) then
		return -- already played locally
	end
	FXHandler.PlayDodge(data.Model, data.Dir)
end

function handlers.Dodged(data)
	local victim = data.Victim
	local head = victim and victim:FindFirstChild("Head")
	if head then
		ctx.VFX.PopText(head.Position + Vector3.new(0, 1.2, 0), "DODGE", ctx.VFX.Palette.Dodge.Accent, 1.1, 0.7, 1.6)
	end
end

local slideFx = {} -- [Model] = { Stop, Sound }

function handlers.Slide(data)
	local model = data.Model
	if isMe(model) then
		return
	end
	local rig = rigOf(model)
	local current = slideFx[model]
	if data.Active then
		if current or not rig then
			return
		end
		rig:Play("Slide")
		local root = rootOf(model)
		slideFx[model] = {
			Stop = ctx.VFX.SlideTrail(model),
			Sound = root and ctx.SFX.Play("SlideLoop", root),
		}
		if root then
			ctx.SFX.Play("SlideStart", root)
		end
	elseif current then
		slideFx[model] = nil
		if rig then
			rig:Stop("Slide")
		end
		current.Stop()
		if current.Sound then
			current.Sound:Stop(0.15)
		end
	end
end

function handlers.Reject(data)
	ctx.CombatController.OnReject(data)
end

function FXHandler.Start(context)
	ctx = context
	ctx.Animator.OnMarker(onMarker)
	ctx.Animator.OnLand(onLand)
	ctx.Animator.OnStep(onStep)
	ctx.Remotes.FX.OnClientEvent:Connect(function(kind, data)
		local handler = handlers[kind]
		if handler and type(data) == "table" then
			local ok, err = pcall(handler, data)
			if not ok then
				warn("[FXHandler]", kind, err)
			end
		end
	end)
end

return FXHandler
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">HUD</string>
            <string name="Source"><![CDATA[-- Combat HUD: health + posture, cooldowns, combo counter, parry banner, controls panel, and
-- overhead health/posture/state plates on every other fighter.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Combat = ReplicatedStorage:WaitForChild("Combat")
local Config = require(Combat.Config)
local Util = require(Combat.Util)

local create = Util.create
local lerp = Util.lerp

local HUD = {}

local player = Players.LocalPlayer
local ctx

local FONT = Enum.Font.GothamBlack
local FONT_BODY = Enum.Font.GothamBold
local COLORS = {
	Panel = Color3.fromRGB(14, 16, 22),
	Health = Color3.fromRGB(92, 230, 120),
	HealthLow = Color3.fromRGB(255, 80, 70),
	Chip = Color3.fromRGB(255, 236, 200),
	Posture = Color3.fromRGB(120, 190, 255),
	PostureLow = Color3.fromRGB(255, 120, 90),
	Gold = Color3.fromRGB(255, 220, 90),
}

local STATE_TAGS = {
	Stunned = { "STUNNED", Color3.fromRGB(255, 170, 80) },
	Parried = { "PARRIED", Color3.fromRGB(255, 220, 90) },
	GuardBroken = { "GUARD BROKEN", Color3.fromRGB(110, 180, 255) },
	Blocking = { "BLOCKING", Color3.fromRGB(170, 215, 255) },
	Dodging = { "DODGE", Color3.fromRGB(170, 225, 255) },
}

local gui
local healthFill, healthChip, healthText, postureFill
local cooldownSlots = {}
local comboFrame, comboNumber, comboScale
local bannerLabel, bannerScale
local helpFrame
local comboCount, lastHit = 0, -math.huge
local shownHealth, chipHealth, chipHoldUntil = 1, 1, 0
local postureFlashUntil = 0

local function corner(parent, radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius or 6), Parent = parent })
end

local function stroke(parent, thickness, transparency)
	return create("UIStroke", {
		Thickness = thickness or 1.5,
		Color = Color3.new(0, 0, 0),
		Transparency = transparency or 0.2,
		Parent = parent,
	})
end

local function bar(parent, size, position, color)
	local back = create("Frame", {
		Size = size,
		Position = position,
		BackgroundColor3 = Color3.fromRGB(8, 9, 12),
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
		Parent = parent,
	})
	corner(back, 4)
	local chip = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = COLORS.Chip,
		BorderSizePixel = 0,
		Parent = back,
	})
	corner(chip, 4)
	local fill = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Parent = back,
	})
	corner(fill, 4)
	create("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 190)),
		Rotation = 90,
		Parent = fill,
	})
	return back, fill, chip
end

----------------------------------------------------------------------------------------------
-- Build

local function buildHUD()
	local playerGui = player:WaitForChild("PlayerGui")
	gui = create("ScreenGui", {
		Name = "CombatHUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})

	-- bottom status block
	local status = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -22),
		Size = UDim2.fromOffset(380, 92),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	local healthBack
	healthBack, healthFill, healthChip = bar(status, UDim2.fromOffset(380, 16), UDim2.fromOffset(0, 0), COLORS.Health)
	healthText = create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "100",
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 13,
		Font = FONT,
		ZIndex = 3,
		Parent = healthBack,
	})
	stroke(healthText, 1.2)
	_, postureFill = bar(status, UDim2.fromOffset(380, 6), UDim2.fromOffset(0, 21), COLORS.Posture)

	local slots = create("Frame", {
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.fromOffset(380, 52),
		BackgroundTransparency = 1,
		Parent = status,
	})
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 10),
		Parent = slots,
	})
	local function slot(key, label)
		local frame = create("Frame", {
			Size = UDim2.fromOffset(52, 52),
			BackgroundColor3 = COLORS.Panel,
			BackgroundTransparency = 0.25,
			Parent = slots,
		})
		corner(frame, 8)
		create(
			"UIStroke",
			{ Thickness = 1.5, Color = Color3.fromRGB(255, 255, 255), Transparency = 0.8, Parent = frame }
		)
		create("TextLabel", {
			Size = UDim2.new(1, 0, 0, 26),
			Position = UDim2.fromOffset(0, 5),
			BackgroundTransparency = 1,
			Text = key,
			TextColor3 = Color3.new(1, 1, 1),
			TextSize = 22,
			Font = FONT,
			ZIndex = 2,
			Parent = frame,
		})
		create("TextLabel", {
			Size = UDim2.new(1, 0, 0, 14),
			Position = UDim2.new(0, 0, 1, -17),
			BackgroundTransparency = 1,
			Text = label,
			TextColor3 = Color3.fromRGB(200, 205, 215),
			TextSize = 10,
			Font = FONT_BODY,
			ZIndex = 2,
			Parent = frame,
		})
		local shade = create("Frame", {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.fromScale(1, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.35,
			ZIndex = 3,
			Parent = frame,
		})
		corner(shade, 8)
		local timer = create("TextLabel", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			TextColor3 = Color3.new(1, 1, 1),
			TextSize = 16,
			Font = FONT,
			ZIndex = 4,
			Parent = frame,
		})
		stroke(timer, 1.2)
		return { Frame = frame, Shade = shade, Timer = timer }
	end
	cooldownSlots.Heavy = slot("R", "HEAVY")
	cooldownSlots.Dodge = slot("Q", "DODGE")
	cooldownSlots.Slide = slot("C", "SLIDE")
	cooldownSlots.Block = slot("F", "PARRY")

	-- combo counter
	comboFrame = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -40, 0.42, 0),
		Size = UDim2.fromOffset(200, 90),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	comboNumber = create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 64),
		BackgroundTransparency = 1,
		Text = "0",
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 64,
		Font = FONT,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = comboFrame,
	})
	stroke(comboNumber, 3, 0)
	comboScale = create("UIScale", { Parent = comboNumber })
	local hitsLabel = create("TextLabel", {
		Position = UDim2.fromOffset(0, 60),
		Size = UDim2.new(1, 0, 0, 24),
		BackgroundTransparency = 1,
		Text = "HIT COMBO",
		TextColor3 = Color3.fromRGB(255, 205, 130),
		TextSize = 20,
		Font = FONT,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = comboFrame,
	})
	stroke(hitsLabel, 2, 0)

	-- parry banner
	bannerLabel = create("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.28),
		Size = UDim2.fromOffset(600, 80),
		BackgroundTransparency = 1,
		Text = "PERFECT PARRY",
		TextColor3 = COLORS.Gold,
		TextSize = 54,
		Font = FONT,
		TextTransparency = 1,
		Parent = gui,
	})
	create("UIStroke", { Thickness = 3, Color = Color3.fromRGB(70, 40, 0), Transparency = 1, Parent = bannerLabel })
	bannerScale = create("UIScale", { Parent = bannerLabel })

	-- controls
	helpFrame = create("Frame", {
		Position = UDim2.fromOffset(16, 70),
		Size = UDim2.fromOffset(250, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = COLORS.Panel,
		BackgroundTransparency = 0.25,
		Parent = gui,
	})
	corner(helpFrame, 10)
	create("UIPadding", {
		PaddingTop = UDim.new(0, 10),
		PaddingBottom = UDim.new(0, 10),
		PaddingLeft = UDim.new(0, 12),
		PaddingRight = UDim.new(0, 12),
		Parent = helpFrame,
	})
	create("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder, Parent = helpFrame })
	local lines = {
		{ "FIST COMBAT", nil },
		{ "LMB", "Punch (4-hit combo, hold to chain)" },
		{ "F", "Block (tap right before a hit = PARRY)" },
		{ "R", "Heavy (breaks blocks, can be parried)" },
		{ "Q", "Dodge (i-frames, use WASD for direction)" },
		{ "W W / Ctrl", "Sprint" },
		{ "C", "Slide while sprinting (jump to keep speed)" },
		{ "H", "Hide this panel" },
	}
	for i, line in ipairs(lines) do
		local key, desc = line[1], line[2]
		if not desc then
			create("TextLabel", {
				LayoutOrder = i,
				Size = UDim2.new(1, 0, 0, 22),
				BackgroundTransparency = 1,
				Text = key,
				TextColor3 = COLORS.Gold,
				TextSize = 17,
				Font = FONT,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = helpFrame,
			})
		else
			local row = create("Frame", {
				LayoutOrder = i,
				Size = UDim2.new(1, 0, 0, 18),
				BackgroundTransparency = 1,
				Parent = helpFrame,
			})
			create("TextLabel", {
				Size = UDim2.fromOffset(70, 18),
				BackgroundTransparency = 1,
				Text = key,
				TextColor3 = Color3.new(1, 1, 1),
				TextSize = 13,
				Font = FONT,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = row,
			})
			create("TextLabel", {
				Position = UDim2.fromOffset(72, 0),
				Size = UDim2.new(1, -72, 0, 18),
				BackgroundTransparency = 1,
				Text = desc,
				TextColor3 = Color3.fromRGB(200, 205, 215),
				TextSize = 12,
				Font = FONT_BODY,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextWrapped = true,
				Parent = row,
			})
		end
	end
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		helpFrame.Visible = false
	end
end

----------------------------------------------------------------------------------------------
-- Overheads

local overheads = {} -- [Model] = data

local function addOverhead(model)
	if overheads[model] or model == player.Character then
		return
	end
	local head = model:WaitForChild("Head", 5)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not (head and humanoid) or overheads[model] then
		return
	end
	local owner = Players:GetPlayerFromCharacter(model)
	local name = model:GetAttribute("DisplayName") or (owner and owner.DisplayName) or model.Name
	local billboard = create("BillboardGui", {
		Name = "Overhead_" .. model.Name,
		Adornee = head,
		Size = UDim2.fromOffset(170, 58),
		StudsOffset = Vector3.new(0, 2.7, 0),
		LightInfluence = 0,
		MaxDistance = 90,
		ResetOnSpawn = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local nameLabel = create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		Text = name,
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 15,
		Font = FONT,
		Parent = billboard,
	})
	stroke(nameLabel, 1.5, 0.1)
	local _, fill, chip = bar(billboard, UDim2.fromOffset(150, 7), UDim2.fromOffset(10, 21), COLORS.Health)
	local postureBack, postureBar = bar(billboard, UDim2.fromOffset(150, 4), UDim2.fromOffset(10, 31), COLORS.Posture)
	local tag = create("TextLabel", {
		Position = UDim2.fromOffset(0, 38),
		Size = UDim2.new(1, 0, 0, 16),
		BackgroundTransparency = 1,
		Text = "",
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 13,
		Font = FONT,
		Parent = billboard,
	})
	stroke(tag, 1.3, 0.1)
	overheads[model] = {
		Gui = billboard,
		Humanoid = humanoid,
		Fill = fill,
		Chip = chip,
		PostureBack = postureBack,
		PostureBar = postureBar,
		Tag = tag,
		Shown = 1,
		ChipValue = 1,
		ChipHold = 0,
	}
end

local function removeOverhead(model)
	local data = overheads[model]
	if data then
		overheads[model] = nil
		data.Gui:Destroy()
	end
end

local function updateOverheads(dt)
	local t = os.clock()
	for model, data in pairs(overheads) do
		if not model.Parent then
			removeOverhead(model)
			continue
		end
		local humanoid = data.Humanoid
		local pct = if humanoid.MaxHealth > 0 then math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1) else 0
		if pct < data.Shown - 0.001 then
			data.ChipHold = t + 0.45
		end
		data.Shown = lerp(data.Shown, pct, 1 - math.exp(-18 * dt))
		if t > data.ChipHold then
			data.ChipValue = lerp(data.ChipValue, data.Shown, 1 - math.exp(-6 * dt))
		end
		data.ChipValue = math.max(data.ChipValue, data.Shown)
		data.Fill.Size = UDim2.fromScale(data.Shown, 1)
		data.Fill.BackgroundColor3 = COLORS.HealthLow:Lerp(COLORS.Health, math.clamp(pct * 1.6, 0, 1))
		data.Chip.Size = UDim2.fromScale(data.ChipValue, 1)

		local posture = model:GetAttribute("Posture") or Config.Block.MaxPosture
		local maxPosture = model:GetAttribute("MaxPosture") or Config.Block.MaxPosture
		local postureFrac = math.clamp(posture / maxPosture, 0, 1)
		data.PostureBack.Visible = postureFrac < 0.995
		data.PostureBar.Size = UDim2.fromScale(postureFrac, 1)
		data.PostureBar.BackgroundColor3 = COLORS.PostureLow:Lerp(COLORS.Posture, postureFrac)

		local tagInfo = STATE_TAGS[model:GetAttribute("CombatState") or ""]
		if tagInfo then
			data.Tag.Text = tagInfo[1]
			data.Tag.TextColor3 = tagInfo[2]
		else
			data.Tag.Text = ""
		end
	end
end

----------------------------------------------------------------------------------------------
-- Public

function HUD.RegisterHit()
	local t = os.clock()
	if t - lastHit > 1.6 then
		comboCount = 0
	end
	comboCount += 1
	lastHit = t
	if comboCount >= 2 and comboFrame then
		comboFrame.Visible = true
		comboNumber.Text = tostring(comboCount)
		comboNumber.TextTransparency = 0
		comboScale.Scale = 1.45
	end
end

function HUD.ParryBanner()
	if not bannerLabel then
		return
	end
	local strokeObj = bannerLabel:FindFirstChildOfClass("UIStroke")
	Util.animate(1.1, function(a)
		if a < 0.1 then
			bannerScale.Scale = lerp(1.8, 0.95, Util.outQuad(a / 0.1))
		elseif a < 0.2 then
			bannerScale.Scale = lerp(0.95, 1, (a - 0.1) / 0.1)
		else
			bannerScale.Scale = 1 + (a - 0.2) * 0.06
		end
		local fade = if a > 0.65 then (a - 0.65) / 0.35 else 0
		bannerLabel.TextTransparency = fade
		if strokeObj then
			strokeObj.Transparency = fade
		end
	end)
end

function HUD.FlashPosture()
	postureFlashUntil = os.clock() + 0.15
end

function HUD.ToggleHelp()
	if helpFrame then
		helpFrame.Visible = not helpFrame.Visible
	end
end

local function updateLocal(dt)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local t = os.clock()
	if humanoid and healthFill then
		local pct = if humanoid.MaxHealth > 0 then math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1) else 0
		if pct < shownHealth - 0.001 then
			chipHoldUntil = t + 0.5
		end
		shownHealth = lerp(shownHealth, pct, 1 - math.exp(-18 * dt))
		if t > chipHoldUntil then
			chipHealth = lerp(chipHealth, shownHealth, 1 - math.exp(-5 * dt))
		end
		chipHealth = math.max(chipHealth, shownHealth)
		healthFill.Size = UDim2.fromScale(shownHealth, 1)
		healthFill.BackgroundColor3 = COLORS.HealthLow:Lerp(COLORS.Health, math.clamp(pct * 1.6, 0, 1))
		healthChip.Size = UDim2.fromScale(chipHealth, 1)
		healthText.Text = tostring(math.ceil(humanoid.Health))

		local posture = character:GetAttribute("Posture") or Config.Block.MaxPosture
		local frac = math.clamp(posture / Config.Block.MaxPosture, 0, 1)
		postureFill.Size = UDim2.fromScale(frac, 1)
		local flash = t < postureFlashUntil
		postureFill.BackgroundColor3 = if flash
			then Color3.new(1, 1, 1)
			else COLORS.PostureLow:Lerp(COLORS.Posture, frac)
	end

	local s = ctx.CombatController.State
	local function setCooldown(slotData, readyAt, total)
		local remaining = readyAt - t
		if remaining > 0 then
			slotData.Shade.Size = UDim2.fromScale(1, math.clamp(remaining / total, 0, 1))
			slotData.Timer.Text = string.format("%.1f", remaining)
		else
			slotData.Shade.Size = UDim2.fromScale(1, 0)
			slotData.Timer.Text = ""
		end
	end
	setCooldown(cooldownSlots.Heavy, s.HeavyCooldownUntil, Config.Heavy.Cooldown)
	setCooldown(cooldownSlots.Dodge, s.DodgeCooldownUntil, Config.Dodge.Cooldown)
	local blockSlot = cooldownSlots.Block
	blockSlot.Frame.BackgroundColor3 = if s.Blocking then Color3.fromRGB(40, 70, 110) else COLORS.Panel
	cooldownSlots.Slide.Frame.BackgroundColor3 = if ctx.Movement.IsSliding()
		then Color3.fromRGB(110, 80, 40)
		else COLORS.Panel

	if comboFrame and comboFrame.Visible then
		comboScale.Scale = lerp(comboScale.Scale, 1, 1 - math.exp(-14 * dt))
		local since = t - lastHit
		if since > 1.6 then
			comboNumber.TextTransparency = math.clamp((since - 1.6) / 0.3, 0, 1)
			if since > 1.9 then
				comboFrame.Visible = false
			end
		end
	end
end

function HUD.Start(context)
	ctx = context
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
	end)
	buildHUD()
	for _, model in ipairs(CollectionService:GetTagged("Combatant")) do
		task.spawn(addOverhead, model)
	end
	CollectionService:GetInstanceAddedSignal("Combatant"):Connect(function(model)
		task.spawn(addOverhead, model)
	end)
	CollectionService:GetInstanceRemovedSignal("Combatant"):Connect(removeOverhead)
	RunService.RenderStepped:Connect(function(dt)
		updateLocal(dt)
		updateOverheads(dt)
	end)
end

return HUD
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">MovementController</string>
            <string name="Source"><![CDATA[-- Local player movement: sprint, slide (slope-aware, steerable, slide-jump momentum), dodge,
-- attack lunges, aim assist and knockback. Also owns the local Humanoid's WalkSpeed and
-- JumpHeight, derived each frame from the combat state the server replicates.
--
-- All velocity changes go through one "mover" (a LinearVelocity on the root) with priorities,
-- so a knockback always wins over a dodge, a dodge over a slide, and so on.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Combat = ReplicatedStorage:WaitForChild("Combat")
local Config = require(Combat.Config)
local Util = require(Combat.Util)

local create = Util.create
local flat = Util.flat

local Movement = {}

local player = Players.LocalPlayer
local ctx
local character, humanoid, root, rootAttachment

local PRIORITY = { Lunge = 1, Slide = 2, Dodge = 3, Knockback = 4 }

local sprintHeld = false
local sprintToggle = false
local lastForwardTap = -math.huge
local stillTime = 0
local currentSpeed = Config.Movement.WalkSpeed
local sprinting = false

local slide = nil
local slideCooldownUntil = 0
local momentum, momentumPeak = 0, 0
local dodgeState = nil
local mover = nil
local windSound = nil

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

----------------------------------------------------------------------------------------------
-- Mover

local function stopMover()
	local m = mover
	if m then
		mover = nil
		if m.Constraint.Parent then
			m.Constraint:Destroy()
		end
		if m.OnStop then
			m.OnStop()
		end
	end
end

local function startMover(name, mode, duration, update, onStop)
	if not root or not rootAttachment then
		return false
	end
	local priority = PRIORITY[name]
	if mover and mover.Priority > priority then
		return false
	end
	stopMover()
	local lv = create("LinearVelocity", {
		Name = "Mover_" .. name,
		Attachment0 = rootAttachment,
		RelativeTo = Enum.ActuatorRelativeTo.World,
		VelocityConstraintMode = mode,
		PrimaryTangentAxis = Vector3.xAxis,
		SecondaryTangentAxis = Vector3.zAxis,
		MaxForce = 1e6,
	})
	mover = {
		Name = name,
		Priority = priority,
		Constraint = lv,
		Update = update,
		Start = os.clock(),
		Duration = duration,
		OnStop = onStop,
	}
	update(0, 0, lv)
	lv.Parent = root
	return true
end

local function setPlane(lv, v)
	lv.PlaneVelocity = Vector2.new(v.X, v.Z)
end

----------------------------------------------------------------------------------------------
-- Queries

local function combatState()
	return character and character:GetAttribute("CombatState") or "Idle"
end

local function isStunnedState(state)
	return state == "Stunned" or state == "Parried" or state == "GuardBroken" or state == "Dead"
end

function Movement.IsSliding()
	return slide ~= nil
end

function Movement.IsDodging()
	return dodgeState ~= nil
end

function Movement.IsSprinting()
	return sprinting
end

function Movement.Character()
	return character, humanoid, root
end

-- Nearest living combatant in front of us (for aim assist / lunge spacing).
function Movement.NearestEnemy(range, minDot)
	if not root then
		return nil
	end
	local look = flat(root.CFrame.LookVector).Unit
	local best, bestDist = nil, range
	for model in pairs(ctx.Animator.All()) do
		if model ~= character and Util.isAlive(model) then
			local delta = flat(model.HumanoidRootPart.Position - root.Position)
			local dist = delta.Magnitude
			if dist < bestDist and dist > 0.05 and look:Dot(delta.Unit) >= (minDot or -1) then
				best, bestDist = model, dist
			end
		end
	end
	return best, bestDist
end

----------------------------------------------------------------------------------------------
-- Actions

local function endSlide(keepMomentum)
	if not slide then
		return
	end
	local s = slide
	slide = nil
	if keepMomentum then
		momentum = s.Speed * Config.Slide.JumpKeep
		momentumPeak = momentum
	end
	if mover and mover.Name == "Slide" then
		stopMover()
	end
	ctx.Animator.Get(character):Stop("Slide")
	s.StopFx()
	if s.Sound then
		s.Sound:Stop(0.15)
	end
	slideCooldownUntil = os.clock() + Config.Slide.Cooldown
	ctx.Send("Slide", { Active = false })
end

function Movement.StopSlide()
	endSlide(false)
end

function Movement.TrySlide()
	if not root or slide or os.clock() < slideCooldownUntil or humanoid.Health <= 0 then
		return false
	end
	local state = combatState()
	if isStunnedState(state) or state == "Attacking" or state == "Blocking" then
		return false
	end
	if ctx.CombatController.IsBusy() or humanoid.FloorMaterial == Enum.Material.Air then
		return false
	end
	local v = flat(root.AssemblyLinearVelocity)
	local speed = v.Magnitude
	if speed < Config.Slide.MinSpeed then
		return false
	end
	local s = {
		Dir = v.Unit,
		Speed = math.min(speed + Config.Slide.Boost, Config.Slide.MaxStartSpeed),
		AirTime = 0,
	}
	slide = s
	local ok = startMover("Slide", Enum.VelocityConstraintMode.Plane, Config.Slide.MaxDuration, function(dt, _, lv)
		if slide ~= s then
			return false
		end
		local move = flat(humanoid.MoveDirection)
		if move.Magnitude > 0.1 and dt > 0 then
			local target = move.Unit
			local angle = math.acos(math.clamp(s.Dir:Dot(target), -1, 1))
			if angle > 1e-3 then
				local step = math.min(1, Config.Slide.Steering * dt / angle)
				s.Dir = s.Dir:Lerp(target, step).Unit
			end
		end
		rayParams.FilterDescendantsInstances = { character, ctx.VFX.Folder() }
		local hit = Workspace:Raycast(root.Position, Vector3.new(0, -4.2, 0), rayParams)
		if hit then
			s.AirTime = 0
			local n = hit.Normal
			local downhill = flat(Vector3.new(0, -1, 0) + n * n.Y)
			s.Speed += Config.Slide.SlopeGravity * downhill:Dot(s.Dir) * dt
			s.Speed -= Config.Slide.Friction * dt
		else
			s.AirTime += dt
			if s.AirTime > 0.18 then
				-- slid off a ledge: carry the speed into the fall
				task.defer(endSlide, true)
				return false
			end
		end
		if s.Speed < Config.Slide.EndSpeed then
			task.defer(endSlide, false)
			return false
		end
		setPlane(lv, s.Dir * s.Speed)
		return true
	end, function()
		if slide == s then
			task.defer(endSlide, false)
		end
	end)
	if not ok then
		slide = nil
		return false
	end
	local rig = ctx.Animator.Get(character)
	rig:Play("Slide")
	s.StopFx = ctx.VFX.SlideTrail(character)
	s.Sound = ctx.SFX.Play("SlideLoop", root)
	ctx.SFX.Play("SlideStart", root)
	ctx.CameraFX.Kick(5)
	ctx.Send("Slide", { Active = true })
	return true
end

local DODGE_VECTORS = {
	Forward = function(cf)
		return cf.LookVector
	end,
	Back = function(cf)
		return -cf.LookVector
	end,
	Left = function(cf)
		return -cf.RightVector
	end,
	Right = function(cf)
		return cf.RightVector
	end,
}

-- Which way should a dodge go, given the current movement input?
function Movement.DodgeDirection()
	if not root or not humanoid then
		return "Back"
	end
	local move = humanoid.MoveDirection
	if move.Magnitude < 0.1 then
		return "Back"
	end
	local rel = root.CFrame:VectorToObjectSpace(move)
	local forward, right = -rel.Z, rel.X
	if math.abs(forward) >= math.abs(right) then
		return if forward > 0 then "Forward" else "Back"
	end
	return if right > 0 then "Right" else "Left"
end

function Movement.Dodge(dirName)
	if not root then
		return false
	end
	endSlide(false)
	local dir = flat(DODGE_VECTORS[dirName](root.CFrame)).Unit
	local d = Config.Dodge
	local state = { Dir = dirName }
	dodgeState = state
	humanoid.AutoRotate = false
	local ok = startMover("Dodge", Enum.VelocityConstraintMode.Plane, d.Duration, function(_, elapsed, lv)
		local a = math.clamp(elapsed / d.Duration, 0, 1)
		setPlane(lv, dir * Util.lerp(d.Speed, d.EndSpeed, Util.outQuad(a)))
		return true
	end, function()
		if dodgeState == state then
			dodgeState = nil
		end
		if humanoid then
			humanoid.AutoRotate = true
		end
	end)
	if not ok then
		dodgeState = nil
		humanoid.AutoRotate = true
	end
	return ok
end

-- Small forward step that sells each punch. Skipped when already in someone's face.
function Movement.Lunge(speed, duration)
	if not root or not speed or speed <= 0 then
		return
	end
	local _, dist = Movement.NearestEnemy(6, 0.3)
	if dist and dist < 3.4 then
		return
	end
	local dir = flat(root.CFrame.LookVector).Unit
	startMover("Lunge", Enum.VelocityConstraintMode.Plane, duration, function(_, elapsed, lv)
		local a = math.clamp(elapsed / duration, 0, 1)
		setPlane(lv, dir * speed * (1 - Util.outQuad(a)))
		return true
	end)
end

-- Turn toward a nearby enemy so close-range punches land where you meant them.
function Movement.AimAssist()
	if not root then
		return
	end
	local target = Movement.NearestEnemy(9, 0.25)
	if target then
		local delta = flat(target.HumanoidRootPart.Position - root.Position)
		if delta.Magnitude > 0.1 then
			root.CFrame = CFrame.lookAt(root.Position, root.Position + delta.Unit)
		end
	end
end

function Movement.ApplyKnockback(vector, duration)
	if not root then
		return
	end
	endSlide(false)
	sprintToggle = false
	local lift = vector.Y > 0.5
	startMover("Knockback", Enum.VelocityConstraintMode.Vector, duration, function(_, elapsed, lv)
		local a = math.clamp(elapsed / duration, 0, 1)
		local v = vector * (1 - 0.35 * a)
		lv.VectorVelocity = if lift then v else Vector3.new(v.X, root.AssemblyLinearVelocity.Y, v.Z)
		return true
	end)
end

function Movement.StopSprint()
	sprintToggle = false
end

----------------------------------------------------------------------------------------------
-- Input

function Movement.SetSprintHeld(held)
	sprintHeld = held
end

function Movement.ToggleSprint()
	sprintToggle = not sprintToggle
end

local FORWARD_KEYS = { [Enum.KeyCode.W] = true, [Enum.KeyCode.Up] = true }

local function onInputBegan(input, processed)
	if processed then
		return
	end
	if FORWARD_KEYS[input.KeyCode] then
		local t = os.clock()
		if t - lastForwardTap <= Config.Sprint.DoubleTapWindow then
			sprintToggle = true
		end
		lastForwardTap = t
	end
end

local function onJumpRequest()
	if slide then
		endSlide(true)
	end
end

----------------------------------------------------------------------------------------------
-- Per-frame

local function update(dt)
	if not humanoid or not root or not root.Parent or humanoid.Health <= 0 then
		return
	end
	local t = os.clock()
	local state = combatState()
	local stunned = isStunnedState(state)
	local combat = ctx.CombatController
	local attacking = combat.IsAttacking() or state == "Attacking"
	local blocking = combat.IsBlocking() or state == "Blocking"
	local moving = humanoid.MoveDirection.Magnitude > 0.1
	local grounded = humanoid.FloorMaterial ~= Enum.Material.Air

	if moving then
		stillTime = 0
	else
		stillTime += dt
		if stillTime > 0.2 then
			sprintToggle = false
		end
	end
	sprinting = (sprintHeld or sprintToggle) and moving and not attacking and not blocking and not stunned and not slide

	local m = Config.Movement
	local target
	if stunned then
		target = m.StunWalkSpeed
	elseif attacking then
		target = if combat.AttackKind() == "Heavy" then m.HeavyWalkSpeed else m.AttackWalkSpeed
	elseif blocking then
		target = m.BlockWalkSpeed
	elseif sprinting then
		target = Config.Sprint.Speed
	else
		target = m.WalkSpeed
	end
	if target > currentSpeed then
		currentSpeed = math.min(target, currentSpeed + Config.Sprint.Acceleration * dt)
	else
		currentSpeed = target
	end

	-- slide-jump momentum: keep it while airborne, bleed it off once landed
	if momentum > 0 then
		if stunned or attacking or blocking then
			momentum = 0
		elseif grounded then
			momentum = math.max(0, momentum - momentumPeak / Config.Slide.MomentumDecay * dt)
		end
	end
	local walkSpeed = math.max(currentSpeed, if stunned then 0 else momentum)
	if math.abs(humanoid.WalkSpeed - walkSpeed) > 0.01 then
		humanoid.WalkSpeed = walkSpeed
	end
	local jump = if stunned or attacking or blocking then 0 else m.JumpHeight
	if humanoid.JumpHeight ~= jump then
		humanoid.JumpHeight = jump
	end
	if humanoid.UseJumpPower then
		humanoid.UseJumpPower = false
	end

	-- mover
	if mover then
		local elapsed = t - mover.Start
		if elapsed >= mover.Duration or mover.Update(dt, elapsed, mover.Constraint) == false then
			stopMover()
		end
	end

	-- camera + wind
	local speed = flat(root.AssemblyLinearVelocity).Magnitude
	local runFactor = math.clamp((speed - 17) / 9, 0, 1)
	local sprintCfg = Config.Sprint
	ctx.CameraFX.SetFOV(
		sprintCfg.BaseFOV + (sprintCfg.SprintFOV - sprintCfg.BaseFOV) * runFactor + (if slide then 4 else 0)
	)
	ctx.CameraFX.SetSpeedLines((speed - sprintCfg.SpeedLinesFrom) / 22)
	if windSound then
		windSound:SetVolume(math.clamp((speed - 18) / 20, 0, 1))
	end
end

local function onCharacter(newCharacter)
	stopMover()
	slide, dodgeState = nil, nil
	momentum, sprintToggle = 0, false
	character = newCharacter
	humanoid = newCharacter:WaitForChild("Humanoid", 10)
	root = newCharacter:WaitForChild("HumanoidRootPart", 10)
	if not (humanoid and root) then
		return
	end
	rootAttachment = root:FindFirstChild("RootAttachment")
		or create("Attachment", { Name = "RootAttachment", Parent = root })
	currentSpeed = Config.Movement.WalkSpeed
	if windSound then
		windSound:Stop()
	end
	windSound = ctx.SFX.Play("SprintWind", root, { Volume = 1 })
	if windSound then
		windSound:SetVolume(0)
	end
end

function Movement.Start(context)
	ctx = context
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	UserInputService.InputBegan:Connect(onInputBegan)
	UserInputService.JumpRequest:Connect(onJumpRequest)
	RunService.PreSimulation:Connect(update)
end

return Movement
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
