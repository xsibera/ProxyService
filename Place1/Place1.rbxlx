      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Combat tuning. Every timing is in seconds, every distance in studs.
-- Server and client both read this, so changes stay in sync automatically.

local Config = {}

Config.Debug = {
	ShowHitboxes = false, -- draw server hitboxes for a moment when an attack goes out
}

Config.Keybinds = {
	Attack = Enum.UserInputType.MouseButton1,
	Block = Enum.KeyCode.F,
	Heavy = Enum.KeyCode.R,
	Dodge = Enum.KeyCode.Q,
	Slide = Enum.KeyCode.C,
	SprintHold = Enum.KeyCode.LeftControl, -- hold to sprint (double-tapping W also sprints)

	GamepadAttack = Enum.KeyCode.ButtonR2,
	GamepadBlock = Enum.KeyCode.ButtonL2,
	GamepadHeavy = Enum.KeyCode.ButtonY,
	GamepadDodge = Enum.KeyCode.ButtonB,
	GamepadSlide = Enum.KeyCode.ButtonX,
	GamepadSprint = Enum.KeyCode.ButtonL3, -- toggles sprint
}

Config.Movement = {
	WalkSpeed = 16,
	AttackWalkSpeed = 6,
	HeavyWalkSpeed = 3,
	BlockWalkSpeed = 7,
	StunWalkSpeed = 2,
	JumpHeight = 7.2,
	-- You leave "combat mode" (fighting stance) this long after your last combat action.
	CombatModeDuration = 6,
}

Config.Sprint = {
	Speed = 26,
	Acceleration = 40, -- studs/s^2 ramp from walk speed up to sprint speed
	DoubleTapWindow = 0.3,
	BaseFOV = 70,
	SprintFOV = 82,
	SpeedLinesFrom = 22, -- speed at which anime speed lines start to appear
}

Config.Slide = {
	MinSpeed = 17, -- you need to be moving at least this fast (sprinting) to slide
	Boost = 9, -- added to your current speed when the slide starts
	MaxStartSpeed = 44,
	Friction = 24, -- deceleration on flat ground (studs/s^2)
	SlopeGravity = 60, -- how strongly slopes speed you up / slow you down
	EndSpeed = 9, -- the slide ends once you're slower than this
	MaxDuration = 1.6,
	Cooldown = 0.45,
	Steering = 2.2, -- radians per second you can steer while sliding
	JumpKeep = 0.95, -- fraction of slide speed kept when you jump out of a slide
	MomentumDecay = 0.7, -- seconds that slide-jump momentum takes to fade back to normal speed
}

Config.Dodge = {
	Duration = 0.26,
	Speed = 62,
	EndSpeed = 18,
	Cooldown = 1.4,
	IFrames = 0.22, -- invulnerable for this long from the start of the dodge
	CanCancelRecovery = true, -- dodge out of the end of a punch (not out of the windup)
}

-- The 4 hit M1 chain. Windup = time from the press until the hitbox fires, which is also
-- the "impact" key in that punch's animation. Duration = time until you can act again.
Config.M1 = {
	ComboResetTime = 0.85, -- how long after a punch ends before the chain resets to hit 1
	ComboEndCooldown = 0.75, -- extra lockout after the 4th hit
	InputBuffer = 0.18, -- a press this close to the end of a punch queues the next one
	Hits = {
		{
			Anim = "Jab",
			Windup = 0.11,
			Duration = 0.33,
			Damage = 4,
			Stun = 0.55,
			PostureDamage = 12,
			Knockback = 9,
			Lunge = 10,
		},
		{
			Anim = "Cross",
			Windup = 0.12,
			Duration = 0.34,
			Damage = 4,
			Stun = 0.55,
			PostureDamage = 12,
			Knockback = 9,
			Lunge = 10,
		},
		{
			Anim = "Hook",
			Windup = 0.14,
			Duration = 0.36,
			Damage = 5,
			Stun = 0.58,
			PostureDamage = 14,
			Knockback = 10,
			Lunge = 11,
		},
		{
			Anim = "Uppercut",
			Windup = 0.19,
			Duration = 0.55,
			Damage = 7,
			Stun = 0.95,
			PostureDamage = 26,
			Knockback = 46,
			KnockUp = 24,
			Lunge = 16,
			Finisher = true,
		},
	},
	Hitbox = {
		Size = Vector3.new(5, 5.5, 6),
		Offset = CFrame.new(0, 0, -3.2),
	},
}

Config.Heavy = {
	Anim = "Heavy",
	Windup = 0.52,
	Duration = 1.0,
	Cooldown = 4.5,
	Damage = 14,
	Stun = 1.0,
	PostureDamage = 100,
	Knockback = 62,
	KnockUp = 26,
	Lunge = 26,
	GuardBreak = true, -- a heavy that hits a block (not a parry) breaks it
	Hitbox = {
		Size = Vector3.new(6, 6, 7.5),
		Offset = CFrame.new(0, 0, -3.8),
	},
}

Config.Block = {
	MaxPosture = 100,
	DamageMultiplier = 0, -- 0 = blocked hits deal no damage, 0.2 = 20% chip damage
	FacingDot = -0.2, -- how far around you a block covers (1 = only dead ahead, -1 = all around)
	PostureRegenDelay = 1.6,
	PostureRegenRate = 22, -- per second
	BlockedPushback = 10,
}

Config.Parry = {
	-- The first part of every block is a parry. A parry stops the attack dead and stuns the
	-- attacker. The window includes a little server leeway to cover average ping.
	Window = 0.24,
	-- Re-pressing block this soon after a failed parry attempt gives a plain block with
	-- no parry window, so mashing block doesn't work.
	Cooldown = 0.7,
	AttackerStun = 1.25,
	PostureRestore = 25,
	AttackerPushback = 14,
}

Config.GuardBreak = {
	Stun = 1.5,
	PostureAfter = 1, -- fraction of max posture you get back once the guard break stun ends
}

Config.Dummy = {
	MaxHealth = 150,
	RespawnTime = 3,
	RegenDelay = 4, -- full heal after this long without being hit
	AttackRange = 6.5,
	AggroRange = 22,
	LeashRange = 28, -- attacking dummies won't wander further than this from their pad
}

Config.Damage = {
	ShowNumbers = true,
}

-- Hitstop (a tiny freeze on contact) sells the impact. Applied to both fighters.
Config.HitStop = {
	Light = 0.055,
	Finisher = 0.11,
	Heavy = 0.14,
	Block = 0.04,
	Parry = 0.16,
	GuardBreak = 0.14,
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">ProceduralAnimator</string>
          <string name="Source"><![CDATA[-- ProceduralAnimator: a client-side R6 animation engine.
--
-- Instead of uploaded Animation assets, every R6 character tagged "Combatant" is posed each
-- frame by writing Motor6D.Transform directly (in RunService.PreSimulation, after Roblox's own
-- animation step). That gives:
--   * true frame-rate animation (sampled at 60/120/240 Hz, not 30 fps keyframes)
--   * stride-synced locomotion (walk/run cycles advance by distance travelled, so no skating)
--   * strafing / backpedalling, lean into acceleration, banking into turns, air poses, landings
--   * layered clips with fades, per-joint masks, hitstop freezes, impact shake and foot planting
--
-- Every client animates every combatant locally. Transform doesn't replicate, so the server
-- broadcasts *what* to play and each client plays it.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Data = require(script.Parent.AnimationData)

local ProceduralAnimator = {}

local JOINTS = { "Root", "Neck", "RArm", "LArm", "RLeg", "LLeg" }
local JOINT_COUNT = #JOINTS
local MOTORS = {
	Root = { "HumanoidRootPart", "RootJoint" },
	Neck = { "Torso", "Neck" },
	RArm = { "Torso", "Right Shoulder" },
	LArm = { "Torso", "Left Shoulder" },
	RLeg = { "Torso", "Right Hip" },
	LLeg = { "Torso", "Left Hip" },
}
local CULL_DISTANCE = 300
local GROUND_TOLERANCE = 0.12

local rad = math.rad
local clamp = math.clamp
local abs = math.abs
local sin = math.sin
local exp = math.exp

----------------------------------------------------------------------------------------------
-- Data compilation: poses become flat arrays (6 joints x 6 numbers) so sampling is just math.

local function zeroPose()
	local p = table.create(JOINT_COUNT * 6, 0)
	return p
end

local function writeJoint(pose, jointIndex, values)
	local o = (jointIndex - 1) * 6
	for i = 1, 6 do
		pose[o + i] = values[i] or 0
	end
end

local poseLibrary = {}

local function compilePose(spec)
	if type(spec) == "string" then
		local p = poseLibrary[spec]
		assert(p, "Unknown pose " .. spec)
		return p
	end
	local pose
	if spec.base then
		local base = poseLibrary[spec.base]
		assert(base, "Unknown pose " .. tostring(spec.base))
		pose = table.clone(base)
	else
		pose = zeroPose()
	end
	for index, joint in ipairs(JOINTS) do
		if spec[joint] then
			writeJoint(pose, index, spec[joint])
		end
	end
	return pose
end

for name, spec in pairs(Data.Poses) do
	-- Poses don't reference each other, so plain compilation is enough.
	local pose = zeroPose()
	for index, joint in ipairs(JOINTS) do
		if spec[joint] then
			writeJoint(pose, index, spec[joint])
		end
	end
	poseLibrary[name] = pose
end

local function parseEase(text)
	if not text or text == "Linear" then
		return Enum.EasingStyle.Linear, Enum.EasingDirection.In
	end
	for _, dir in ipairs({ "InOut", "Out", "In" }) do
		if text:sub(-#dir) == dir then
			return Enum.EasingStyle[text:sub(1, -#dir - 1)], Enum.EasingDirection[dir]
		end
	end
	return Enum.EasingStyle[text], Enum.EasingDirection.InOut
end

local clips = {}
for name, spec in pairs(Data.Animations) do
	local keys = {}
	for i, k in ipairs(spec.Keyframes) do
		local style, dir = parseEase(k.ease)
		keys[i] = { t = k.t, pose = compilePose(k.pose), style = style, dir = dir }
	end
	local markers = table.clone(spec.Markers or {})
	table.sort(markers, function(a, b)
		return a.t < b.t
	end)
	clips[name] = {
		Name = name,
		Length = spec.Length,
		Looped = spec.Looped == true,
		FadeIn = spec.FadeIn or 0.05,
		FadeOut = spec.FadeOut or 0.15,
		Priority = spec.Priority or 1,
		UpperBodyWhileMoving = spec.UpperBodyWhileMoving == true,
		Tremble = spec.Tremble,
		Stride = spec.Stride,
		Keys = keys,
		Markers = markers,
	}
end
ProceduralAnimator.Clips = clips

-- Samples a clip at time t into `out` (a flat pose array).
local function sampleClip(clip, t, out)
	local keys = clip.Keys
	local n = #keys
	if t <= keys[1].t or n == 1 then
		table.move(keys[1].pose, 1, JOINT_COUNT * 6, 1, out)
		return out
	end
	if t >= keys[n].t then
		table.move(keys[n].pose, 1, JOINT_COUNT * 6, 1, out)
		return out
	end
	local a, b = keys[1], keys[2]
	for i = 2, n do
		if keys[i].t >= t then
			a, b = keys[i - 1], keys[i]
			break
		end
	end
	local span = b.t - a.t
	local alpha = if span > 0 then (t - a.t) / span else 1
	if b.style ~= Enum.EasingStyle.Linear then
		alpha = TweenService:GetValue(alpha, b.style, b.dir)
	end
	local pa, pb = a.pose, b.pose
	for i = 1, JOINT_COUNT * 6 do
		local va = pa[i]
		out[i] = va + (pb[i] - va) * alpha
	end
	return out
end

local function blendInto(dst, src, weight, mask)
	if weight <= 0 then
		return
	end
	for j = 1, JOINT_COUNT do
		local w = weight * (if mask then mask[j] else 1)
		if w > 0 then
			local o = (j - 1) * 6
			if w >= 1 then
				for i = o + 1, o + 6 do
					dst[i] = src[i]
				end
			else
				for i = o + 1, o + 6 do
					local d = dst[i]
					dst[i] = d + (src[i] - d) * w
				end
			end
		end
	end
end

local function jointCFrame(pose, j)
	local o = (j - 1) * 6
	return CFrame.new(pose[o + 4], pose[o + 5], pose[o + 6])
		* CFrame.fromEulerAnglesYXZ(rad(pose[o + 1]), rad(pose[o + 2]), rad(pose[o + 3]))
end

local function damp(current, target, speed, dt)
	return target + (current - target) * exp(-speed * dt)
end

-- Did a phase value in [0, 1) pass `mark` going from a to b? mark = 1 means the wrap point.
local function crossedMark(a, b, mark, forward)
	if forward then
		if b >= a then
			return a < mark and mark <= b
		end
		return mark > a or mark <= b
	end
	if b <= a then
		return b < mark and mark <= a
	end
	return mark <= a or mark > b
end

-- Clips that count as fighting (they put the rig into its fighting stance for a while).
local NON_COMBAT_CLIPS = { Slide = true, Land = true, Idle = true, Walk = true, Run = true }

----------------------------------------------------------------------------------------------
-- Rig

local Rig = {}
Rig.__index = Rig

local rigs = {} -- [Model] = Rig
local markerListeners = {}
local landListeners = {}
local stepListeners = {}

local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude
raycastParams.IgnoreWater = true

local function newRig(model)
	local root = model:FindFirstChild("HumanoidRootPart")
	local torso = model:FindFirstChild("Torso")
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not (root and torso and humanoid) then
		return nil
	end
	local motors, rotations, inverses = {}, {}, {}
	for j, joint in ipairs(JOINTS) do
		local info = MOTORS[joint]
		local parent = model:FindFirstChild(info[1])
		local motor = parent and parent:FindFirstChild(info[2])
		if not (motor and motor:IsA("Motor6D")) then
			return nil -- not an R6 rig
		end
		motors[j] = motor
		rotations[j] = motor.C0.Rotation
		inverses[j] = motor.C0.Rotation:Inverse()
	end

	local self = setmetatable({
		Model = model,
		Humanoid = humanoid,
		Root = root,
		Motors = motors,
		Rot = rotations,
		RotInv = inverses,
		Tracks = {},
		Pose = zeroPose(),
		Scratch = zeroPose(),
		Scratch2 = zeroPose(),
		Phase = 0,
		IdleTime = math.random() * 3,
		CombatIdleTime = 0,
		SpeedSmooth = 0,
		RunBlend = 0,
		AirBlend = 0,
		VerticalSmooth = 0,
		LegYaw = 0,
		Backwards = 0,
		LeanPitch = 0,
		BankRoll = 0,
		LastForwardSpeed = 0,
		LastYaw = nil,
		Grounded = true,
		AirTime = 0,
		LastAirVY = 0,
		FrozenUntil = 0,
		ShakeUntil = 0,
		ShakeAmount = 0,
		CombatModeUntil = 0,
		GroundLift = 0,
		Enabled = true,
	}, Rig)

	-- Reference foot height in rest pose, used for foot planting.
	self.RestFootY = self:_lowestFootY(zeroPose())
	return self
end

function Rig:_lowestFootY(pose)
	local motors = self.Motors
	-- Torso in HumanoidRootPart space
	local rootMotor = motors[1]
	local rootT = self.RotInv[1] * jointCFrame(pose, 1) * self.Rot[1]
	local torsoCF = rootMotor.C0 * rootT * rootMotor.C1:Inverse()
	local lowest = math.huge
	for j = 5, 6 do
		local motor = motors[j]
		local t = self.RotInv[j] * jointCFrame(pose, j) * self.Rot[j]
		local legCF = torsoCF * motor.C0 * t * motor.C1:Inverse()
		local leg = motor.Part1
		local half = if leg then leg.Size * 0.5 else Vector3.new(0.5, 1, 0.5)
		for _, sx in ipairs({ -1, 1 }) do
			for _, sz in ipairs({ -1, 1 }) do
				local y = (legCF * Vector3.new(half.X * sx, -half.Y, half.Z * sz)).Y
				if y < lowest then
					lowest = y
				end
			end
		end
	end
	return lowest
end

-- Plays a clip. opts: Speed, Weight, FadeIn, Looped, StartTime, Mask ({Joint = weight}).
function Rig:Play(name, opts)
	local clip = clips[name]
	if not clip then
		warn("[ProceduralAnimator] unknown clip", name)
		return nil
	end
	opts = opts or {}
	-- Restarting a clip that's already playing reuses its slot so it doesn't stack.
	for i = #self.Tracks, 1, -1 do
		local existing = self.Tracks[i]
		if existing.Clip == clip then
			table.remove(self.Tracks, i)
		end
	end
	local mask
	if opts.Mask then
		mask = table.create(JOINT_COUNT, 0)
		for j, joint in ipairs(JOINTS) do
			mask[j] = opts.Mask[joint] or 0
		end
	end
	local track = {
		Clip = clip,
		Name = name,
		Time = opts.StartTime or 0,
		Speed = opts.Speed or 1,
		TargetWeight = opts.Weight or 1,
		Weight = 0,
		FadeIn = opts.FadeIn or clip.FadeIn,
		FadeOut = clip.FadeOut,
		Looped = if opts.Looped ~= nil then opts.Looped else clip.Looped,
		Stopping = false,
		Mask = mask,
		Started = os.clock(),
		NextMarker = 1,
		Data = opts.Data,
	}
	if track.FadeIn <= 0 then
		track.Weight = track.TargetWeight
	end
	-- skip markers that are before the start time
	while clip.Markers[track.NextMarker] and clip.Markers[track.NextMarker].t < track.Time do
		track.NextMarker += 1
	end
	table.insert(self.Tracks, track)
	table.sort(self.Tracks, function(a, b)
		if a.Clip.Priority == b.Clip.Priority then
			return a.Started < b.Started
		end
		return a.Clip.Priority < b.Clip.Priority
	end)
	if clip.Priority >= 2 and not NON_COMBAT_CLIPS[name] then
		self.CombatModeUntil = math.max(self.CombatModeUntil, os.clock() + 6)
	end
	return track
end

function Rig:Stop(nameOrTrack, fadeOut)
	for _, track in ipairs(self.Tracks) do
		if track == nameOrTrack or track.Name == nameOrTrack then
			track.Stopping = true
			if fadeOut then
				track.FadeOut = fadeOut
			end
		end
	end
end

-- Stops every clip at or above minPriority (default: all non-locomotion clips).
function Rig:StopAll(fadeOut, minPriority)
	for _, track in ipairs(self.Tracks) do
		if track.Clip.Priority >= (minPriority or 1) then
			track.Stopping = true
			if fadeOut then
				track.FadeOut = fadeOut
			end
		end
	end
end

function Rig:IsPlaying(name)
	for _, track in ipairs(self.Tracks) do
		if track.Name == name and not track.Stopping then
			return true
		end
	end
	return false
end

-- Hitstop: freezes the rig's clips for a moment.
function Rig:Freeze(duration)
	self.FrozenUntil = math.max(self.FrozenUntil, os.clock() + duration)
end

function Rig:Shake(amount, duration)
	self.ShakeAmount = math.max(amount, if os.clock() < self.ShakeUntil then self.ShakeAmount else 0)
	self.ShakeUntil = math.max(self.ShakeUntil, os.clock() + duration)
end

function Rig:SetCombatMode(seconds)
	self.CombatModeUntil = math.max(self.CombatModeUntil, os.clock() + seconds)
end

function Rig:_isGrounded(velocity)
	local humanoid = self.Humanoid
	local localPlayer = Players.LocalPlayer
	if localPlayer and self.Model == localPlayer.Character then
		return humanoid.FloorMaterial ~= Enum.Material.Air
	end
	if abs(velocity.Y) > 6 then
		-- quick reject: clearly jumping or falling
		local state = humanoid:GetState()
		if state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping then
			return false
		end
	end
	raycastParams.FilterDescendantsInstances = { self.Model }
	local result = Workspace:Raycast(self.Root.Position, Vector3.new(0, -3.9, 0), raycastParams)
	return result ~= nil
end

local walkClip, runClip = clips.Walk, clips.Run
local idleClip, combatIdleClip = clips.Idle, clips.CombatIdle
local jumpPose, fallPose = poseLibrary.Jump, poseLibrary.Fall
local ARM_MASK = { 0, 1, 1, 1, 0, 0 } -- Neck + arms
local UPPER_MASK_MOVING = { 0.5, 1, 1, 1, 0, 0 }

function Rig:_locomotion(dt, now, frozen)
	local root = self.Root
	local velocity = root.AssemblyLinearVelocity
	local cf = root.CFrame
	local localVel = cf:VectorToObjectSpace(velocity)
	local forward, right = -localVel.Z, localVel.X
	local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude

	local grounded = self:_isGrounded(velocity)
	if grounded then
		if not self.Grounded and self.AirTime > 0.12 and self.LastAirVY < -18 then
			local impact = clamp((-self.LastAirVY - 18) / 50, 0.35, 1)
			self:Play("Land", { Weight = impact })
			for _, fn in ipairs(landListeners) do
				task.spawn(fn, self, impact)
			end
		end
		self.AirTime = 0
	else
		self.AirTime += dt
		self.LastAirVY = velocity.Y
	end
	self.Grounded = grounded

	self.SpeedSmooth = damp(self.SpeedSmooth, if grounded then speed else 0, 14, dt)
	local s = self.SpeedSmooth
	local moving = clamp((s - 0.6) / 3, 0, 1)
	self.RunBlend = damp(self.RunBlend, clamp((s - 17) / 6, 0, 1), 8, dt)
	local runW = self.RunBlend
	local airTarget = if grounded or self.AirTime < 0.08 then 0 else 1
	self.AirBlend = damp(self.AirBlend, airTarget, 12, dt)
	self.VerticalSmooth = damp(self.VerticalSmooth, velocity.Y, 10, dt)

	-- Movement direction relative to facing (for strafing / backpedalling)
	local yawTarget, backwards = 0, false
	if speed > 1.5 then
		local theta = math.deg(math.atan2(right, forward)) -- 0 forward, +90 right
		if abs(theta) > 105 then
			backwards = true
			theta = theta - 180 * math.sign(theta)
		end
		yawTarget = clamp(-theta, -70, 70)
	end
	self.LegYaw = damp(self.LegYaw, yawTarget, 10, dt)
	self.Backwards = damp(self.Backwards, if backwards then 1 else 0, 10, dt)

	-- Advance stride phase by distance travelled
	if not frozen then
		local stride = walkClip.Stride + (runClip.Stride - walkClip.Stride) * runW
		local dir = if backwards then -1 else 1
		self.Phase = (self.Phase + dir * s * dt / stride) % 1
		self.IdleTime += dt
		self.CombatIdleTime += dt
	end

	-- Footsteps: both cycles plant a foot at phase 0 and 0.5
	local phase = self.Phase
	local lastPhase = self.LastPhase or phase
	self.LastPhase = phase
	if grounded and s > 4 and #stepListeners > 0 and lastPhase ~= phase then
		if crossedMark(lastPhase, phase, 0.5, not backwards) or crossedMark(lastPhase, phase, 1, not backwards) then
			for _, fn in ipairs(stepListeners) do
				task.spawn(fn, self, runW, s)
			end
		end
	end

	-- Base: idle, or fighting stance when in combat
	local pose = self.Pose
	local combat = self.Model:GetAttribute("AlwaysCombat") == true or now < self.CombatModeUntil
	self.CombatBlend = damp(self.CombatBlend or 0, if combat then 1 else 0, 6, dt)
	local cw = self.CombatBlend
	local scratch = self.Scratch
	sampleClip(idleClip, self.IdleTime % idleClip.Length, pose)
	if cw > 0.001 then
		sampleClip(combatIdleClip, self.CombatIdleTime % combatIdleClip.Length, scratch)
		blendInto(pose, scratch, cw)
	end

	-- Walk / run cycles
	if moving > 0.001 then
		local cyc = self.Scratch2
		sampleClip(walkClip, phase, cyc)
		if runW > 0.001 then
			sampleClip(runClip, phase, scratch)
			blendInto(cyc, scratch, runW)
		end
		-- Fighting stance keeps the guard up while walking (not while sprinting)
		local guardArms = cw * (1 - runW)
		if guardArms > 0.001 then
			sampleClip(combatIdleClip, self.CombatIdleTime % combatIdleClip.Length, scratch)
			blendInto(cyc, scratch, guardArms * 0.85, ARM_MASK)
		end
		blendInto(pose, cyc, moving)
	end

	-- Strafing: turn the legs toward the travel direction
	local legYaw = self.LegYaw * moving
	if abs(legYaw) > 0.01 then
		pose[(5 - 1) * 6 + 2] += legYaw
		pose[(6 - 1) * 6 + 2] += legYaw
		pose[2] += legYaw * 0.25 -- torso follows a little
		pose[6 + 2] -= legYaw * 0.2 -- head stays forward
	end

	-- Air
	local air = self.AirBlend
	if air > 0.001 then
		local vy = self.VerticalSmooth
		local fallW = clamp((-vy + 4) / 30, 0, 1)
		local airPose = scratch
		for i = 1, JOINT_COUNT * 6 do
			airPose[i] = jumpPose[i] + (fallPose[i] - jumpPose[i]) * fallW
		end
		-- arms flail a little when falling
		local flail = sin(now * 9) * 7 * fallW
		airPose[(3 - 1) * 6 + 1] += flail
		airPose[(4 - 1) * 6 + 1] -= flail
		blendInto(pose, airPose, air)
	end

	-- Lean into acceleration and bank into turns (only while moving on the ground)
	local smoothedForward = damp(self.LastForwardSpeed, if grounded then forward else 0, 10, dt)
	local accel = if dt > 0 then (smoothedForward - self.LastForwardSpeed) / dt else 0
	self.LastForwardSpeed = smoothedForward
	local _, yaw = cf:ToEulerAnglesYXZ()
	local yawRate = 0
	if self.LastYaw and dt > 0 then
		local d = yaw - self.LastYaw
		if d > math.pi then
			d -= 2 * math.pi
		elseif d < -math.pi then
			d += 2 * math.pi
		end
		yawRate = d / dt
	end
	self.LastYaw = yaw
	self.LeanPitch = damp(self.LeanPitch, clamp(-accel * 0.18, -9, 7) * moving, 6, dt)
	self.BankRoll = damp(self.BankRoll, clamp(yawRate * s * 0.55, -14, 14) * (if grounded then 1 else 0.4), 7, dt)
	pose[1] += self.LeanPitch
	pose[3] += self.BankRoll

	return grounded, moving
end

function Rig:Step(dt, now)
	local frozen = now < self.FrozenUntil
	local clipDt = if frozen then 0 else dt

	local grounded, moving = self:_locomotion(dt, now, frozen)
	local pose = self.Pose
	local scratch = self.Scratch

	-- Clips
	local tracks = self.Tracks
	local i = 1
	while i <= #tracks do
		local track = tracks[i]
		local clip = track.Clip
		local prevTime = track.Time
		track.Time += clipDt * track.Speed
		if track.Looped then
			if track.Time >= clip.Length then
				track.Time %= clip.Length
				track.NextMarker = 1
			end
		elseif not track.Stopping and track.Time >= clip.Length - track.FadeOut then
			track.Stopping = true
		end
		-- markers
		local markers = clip.Markers
		while markers[track.NextMarker] and markers[track.NextMarker].t <= track.Time do
			local marker = markers[track.NextMarker]
			track.NextMarker += 1
			if marker.t >= prevTime or track.Looped then
				for _, fn in ipairs(markerListeners) do
					task.spawn(fn, self, track, marker)
				end
			end
		end
		-- weights
		if track.Stopping then
			local rate = if track.FadeOut > 0 then track.TargetWeight / track.FadeOut else math.huge
			track.Weight -= rate * dt
		elseif track.Weight < track.TargetWeight then
			local rate = if track.FadeIn > 0 then track.TargetWeight / track.FadeIn else math.huge
			track.Weight = math.min(track.TargetWeight, track.Weight + rate * dt)
		end
		if track.Weight <= 0 and track.Stopping then
			table.remove(tracks, i)
		else
			local t = if track.Looped then track.Time else math.min(track.Time, clip.Length)
			sampleClip(clip, t, scratch)
			if clip.Tremble and t >= clip.Tremble.from and t <= clip.Tremble.to then
				local amt = clip.Tremble.amount
				for j = 1, JOINT_COUNT do
					local o = (j - 1) * 6
					scratch[o + 1] += (math.random() - 0.5) * amt
					scratch[o + 2] += (math.random() - 0.5) * amt
				end
			end
			local mask = track.Mask
			if clip.UpperBodyWhileMoving and moving > 0.05 then
				track.DynMask = track.DynMask or table.create(JOINT_COUNT, 0)
				mask = track.DynMask
				for j = 1, JOINT_COUNT do
					local full = if track.Mask then track.Mask[j] else 1
					local upper = UPPER_MASK_MOVING[j]
					mask[j] = full * (1 + (upper - 1) * moving)
				end
			end
			blendInto(pose, scratch, math.clamp(track.Weight, 0, 1), mask)
			i += 1
		end
	end

	-- Impact shake
	if now < self.ShakeUntil then
		local remaining = (self.ShakeUntil - now)
		local amt = self.ShakeAmount * clamp(remaining * 8, 0, 1)
		pose[1] += (math.random() - 0.5) * amt
		pose[2] += (math.random() - 0.5) * amt
		pose[3] += (math.random() - 0.5) * amt
		pose[4] += (math.random() - 0.5) * amt * 0.02
		pose[6] += (math.random() - 0.5) * amt * 0.02
	end

	-- Foot planting: R6 legs are rigid, so when the torso dips we lift the hips just enough to
	-- keep the feet on the floor. Smoothed so it never pops.
	local lift = 0
	if grounded then
		local lowest = self:_lowestFootY(pose)
		lift = math.max(0, (self.RestFootY - GROUND_TOLERANCE) - lowest)
	end
	self.GroundLift = damp(self.GroundLift, lift, 30, dt)
	pose[5] += self.GroundLift

	-- Write the Motor6D transforms (parent-space pose conjugated into joint space)
	local motors, rot, rotInv = self.Motors, self.Rot, self.RotInv
	for j = 1, JOINT_COUNT do
		motors[j].Transform = rotInv[j] * jointCFrame(pose, j) * rot[j]
	end
end

function Rig:Reset()
	for _, motor in ipairs(self.Motors) do
		if motor.Parent then
			motor.Transform = CFrame.identity
		end
	end
end

----------------------------------------------------------------------------------------------
-- Public API

function ProceduralAnimator.Get(model)
	local rig = rigs[model]
	if rig == nil and model and model.Parent then
		rig = newRig(model)
		if rig then
			rigs[model] = rig
		end
	end
	return rig
end

function ProceduralAnimator.Remove(model)
	local rig = rigs[model]
	if rig then
		rigs[model] = nil
		rig:Reset()
	end
end

function ProceduralAnimator.All()
	return rigs
end

-- fn(rig, track, marker) for every marker crossed in any clip.
function ProceduralAnimator.OnMarker(fn)
	table.insert(markerListeners, fn)
end

-- fn(rig, impact01) when a rig lands from a real fall.
function ProceduralAnimator.OnLand(fn)
	table.insert(landListeners, fn)
end

-- fn(rig, runBlend, speed) on every footfall.
function ProceduralAnimator.OnStep(fn)
	table.insert(stepListeners, fn)
end

local started = false
function ProceduralAnimator.Start()
	if started then
		return
	end
	started = true
	RunService.PreSimulation:Connect(function(dt)
		local now = os.clock()
		local camera = Workspace.CurrentCamera
		local camPos = if camera then camera.CFrame.Position else Vector3.zero
		dt = math.min(dt, 0.1)
		for model, rig in pairs(rigs) do
			if not model.Parent or not rig.Root.Parent or not rig.Motors[1].Parent then
				rigs[model] = nil
			elseif rig.Enabled and rig.Humanoid.Health > 0 then
				if (rig.Root.Position - camPos).Magnitude < CULL_DISTANCE then
					local ok, err = pcall(rig.Step, rig, dt, now)
					if not ok then
						warn("[ProceduralAnimator]", model.Name, err)
						rig.Enabled = false
					end
				end
			end
		end
	end)
end

return ProceduralAnimator
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">SFX</string>
          <string name="Source"><![CDATA[-- Client-side sound player. Plays Creator Store IDs from SoundIds when they load, otherwise
-- the built-in layered fallback, so every action always has a sound.

local ContentProvider = game:GetService("ContentProvider")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local SoundIds = require(script.Parent.SoundIds)
local Util = require(script.Parent.Util)

local create = Util.create

local SFX = {}

local idStatus = {} -- [contentId] = true (loaded) | false (failed)

local function normalise(id)
	if type(id) == "number" then
		return "rbxassetid://" .. id
	end
	if type(id) == "string" and id:match("^%d+$") then
		return "rbxassetid://" .. id
	end
	return id
end

function SFX.Preload()
	local probes = {}
	for _, def in pairs(SoundIds) do
		for i, id in ipairs(def.Ids or {}) do
			id = normalise(id)
			def.Ids[i] = id
			if idStatus[id] == nil then
				table.insert(probes, create("Sound", { SoundId = id }))
			end
		end
	end
	if #probes == 0 then
		return
	end
	task.spawn(function()
		local ok, err = pcall(function()
			ContentProvider:PreloadAsync(probes, function(contentId, status)
				if status == Enum.AssetFetchStatus.Success then
					idStatus[contentId] = true
				elseif status == Enum.AssetFetchStatus.Failure or status == Enum.AssetFetchStatus.TimedOut then
					idStatus[contentId] = false
					warn("[SFX] couldn't load " .. contentId .. ", using the built-in fallback")
				end
			end)
		end)
		if not ok then
			warn("[SFX] preload failed:", err)
		end
		for _, probe in ipairs(probes) do
			probe:Destroy()
		end
	end)
end

local soundRoot
local function emitterAt(position)
	if not soundRoot or not soundRoot.Parent then
		soundRoot = create("Part", {
			Name = "CombatSFX_Local",
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			Transparency = 1,
			Size = Vector3.new(0.2, 0.2, 0.2),
			CFrame = CFrame.new(0, -500, 0),
			Parent = Workspace,
		})
	end
	-- soundRoot is axis-aligned, so a world position maps to a plain offset from it
	return create("Attachment", { Position = position - soundRoot.Position, Parent = soundRoot })
end

local function applyEffects(sound, layer)
	if layer.Eq then
		create("EqualizerSoundEffect", {
			LowGain = layer.Eq[1],
			MidGain = layer.Eq[2],
			HighGain = layer.Eq[3],
			Priority = 1,
			Parent = sound,
		})
	end
	if layer.Distortion then
		create("DistortionSoundEffect", { Level = layer.Distortion, Priority = 2, Parent = sound })
	end
	if layer.Reverb then
		create("ReverbSoundEffect", {
			DecayTime = 0.6 + layer.Reverb * 1.6,
			Density = 1,
			Diffusion = 1,
			DryLevel = 0,
			WetLevel = -18 + layer.Reverb * 14,
			Priority = 3,
			Parent = sound,
		})
	end
end

local function playOne(parent, id, volume, speed, opts)
	local sound = create("Sound", {
		SoundId = id,
		Volume = volume,
		PlaybackSpeed = speed,
		Looped = opts.Looped == true,
		RollOffMode = Enum.RollOffMode.InverseTapered,
		RollOffMinDistance = 12,
		RollOffMaxDistance = 160,
	})
	applyEffects(sound, opts)
	sound.Parent = parent
	if opts.Start then
		sound.TimePosition = opts.Start
	end
	sound:Play()
	if opts.Rise and opts.Length then
		TweenService:Create(sound, TweenInfo.new(opts.Length, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			PlaybackSpeed = speed * opts.Rise,
		}):Play()
	end
	if opts.Length and not opts.Looped then
		local fade = math.max(0.03, opts.Length * 0.4)
		task.delay(opts.Length - fade, function()
			if sound.Parent then
				TweenService:Create(sound, TweenInfo.new(fade, Enum.EasingStyle.Quad), { Volume = 0 }):Play()
			end
		end)
		Debris:AddItem(sound, opts.Length + 0.1)
	elseif not opts.Looped then
		sound.Ended:Once(function()
			sound:Destroy()
		end)
		Debris:AddItem(sound, 8)
	end
	return sound
end

-- Plays a named sound at a Vector3, BasePart or Attachment.
-- opts: Volume (multiplier), Pitch (multiplier). Returns a handle with :Stop(fadeTime).
function SFX.Play(name, at, opts)
	local def = SoundIds[name]
	if not def then
		warn("[SFX] unknown sound", name)
		return nil
	end
	opts = opts or {}
	local parent, cleanupParent
	if typeof(at) == "Vector3" then
		parent = emitterAt(at)
		cleanupParent = parent
	elseif typeof(at) == "Instance" then
		parent = at
	else
		return nil
	end

	local volumeMul = opts.Volume or 1
	local pitchMul = opts.Pitch or 1
	local sounds = {}

	local usable = {}
	for _, id in ipairs(def.Ids or {}) do
		if idStatus[id] ~= false then
			table.insert(usable, id)
		end
	end

	if #usable > 0 then
		local id = usable[math.random(1, #usable)]
		table.insert(
			sounds,
			playOne(parent, id, (def.Volume or 0.6) * volumeMul, Util.randRange(def.Pitch or { 1, 1 }) * pitchMul, {
				Looped = def.Looped,
				Length = def.Length,
			})
		)
	else
		for _, layer in ipairs(def.Fallback or {}) do
			local volume = (layer.Volume or 1) * (def.Volume or 0.6) * volumeMul
			local speed = Util.randRange(layer.Pitch or { 1, 1 }) * pitchMul
			table.insert(sounds, playOne(parent, layer.Id, volume, speed, layer))
		end
	end

	if cleanupParent then
		Debris:AddItem(cleanupParent, 10)
	end

	local handle = {}
	function handle:Stop(fadeTime)
		for _, sound in ipairs(sounds) do
			if sound.Parent then
				if fadeTime and fadeTime > 0 then
					TweenService:Create(sound, TweenInfo.new(fadeTime), { Volume = 0 }):Play()
					Debris:AddItem(sound, fadeTime + 0.05)
				else
					sound:Destroy()
				end
			end
		end
	end
	function handle:SetVolume(multiplier)
		for i, sound in ipairs(sounds) do
			if sound.Parent then
				local base = sound:GetAttribute("BaseVolume") or sound.Volume
				sound:SetAttribute("BaseVolume", base)
				sounds[i].Volume = base * multiplier
			end
		end
	end
	return handle
end

return SFX
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">SoundIds</string>
          <string name="Source"><![CDATA[-- Sound IDs for every combat / movement sound.
--
-- Put Creator Store (toolbox) audio IDs in the `Ids` lists. When a list has several IDs, a
-- random one plays each time for variety. A sound with no IDs, or whose IDs fail to load,
-- automatically uses its built-in `Fallback`. Fallbacks are layered, pitched and EQ'd
-- versions of sounds that ship with every Roblox client, so the game never goes silent.
--
-- Fields:
--   Ids       = { "rbxassetid://123", ... }
--   Volume    = number
--   Pitch     = { min, max }       random PlaybackSpeed per play
--   Length    = seconds           optional: fade the sound out after this long
--   Fallback  = { layer, ... }     built-in layers: { Id, Volume, Pitch = {min,max}, Start,
--                                  Length, Eq = {Low, Mid, High}, Distortion, Reverb }

local BUILTIN = {
	Wind = "rbxasset://sounds/action_falling.ogg",
	Boom = "rbxasset://sounds/impact_explosion_03.mp3",
	Thud = "rbxasset://sounds/action_jump_land.mp3",
	Steps = "rbxasset://sounds/action_footsteps_plastic.mp3",
	Swim = "rbxasset://sounds/action_swim.mp3",
	Click = "rbxasset://sounds/volume_slider.ogg",
	GetUp = "rbxasset://sounds/action_get_up.mp3",
	Jump = "rbxasset://sounds/action_jump.mp3",
}

return {
	Swing = {
		Ids = {},
		Volume = 0.55,
		Pitch = { 0.95, 1.1 },
		Fallback = {
			{ Id = BUILTIN.Wind, Volume = 1.4, Pitch = { 2.3, 2.7 }, Start = 0.4, Length = 0.2, Eq = { -30, 0, 6 } },
		},
	},
	SwingHeavy = {
		Ids = {},
		Volume = 0.7,
		Pitch = { 0.92, 1.0 },
		Fallback = {
			{ Id = BUILTIN.Wind, Volume = 1.8, Pitch = { 1.45, 1.6 }, Start = 0.3, Length = 0.42, Eq = { -20, 2, 4 } },
		},
	},
	Hit = {
		Ids = {},
		Volume = 0.8,
		Pitch = { 0.92, 1.1 },
		Fallback = {
			{
				Id = BUILTIN.Boom,
				Volume = 0.9,
				Pitch = { 2.4, 2.8 },
				Length = 0.16,
				Eq = { 4, 0, -4 },
				Distortion = 0.35,
			},
			{ Id = BUILTIN.Thud, Volume = 1.2, Pitch = { 1.25, 1.45 }, Length = 0.18, Eq = { 6, 0, -10 } },
		},
	},
	HitFinisher = {
		Ids = {},
		Volume = 0.95,
		Pitch = { 0.9, 1.0 },
		Fallback = {
			{
				Id = BUILTIN.Boom,
				Volume = 1.2,
				Pitch = { 1.7, 1.9 },
				Length = 0.32,
				Eq = { 6, 0, -2 },
				Distortion = 0.45,
			},
			{ Id = BUILTIN.Thud, Volume = 1.4, Pitch = { 0.95, 1.05 }, Length = 0.25, Eq = { 8, 0, -10 } },
			{ Id = BUILTIN.Wind, Volume = 0.9, Pitch = { 1.9, 2.1 }, Start = 0.4, Length = 0.3, Eq = { -30, 0, 4 } },
		},
	},
	HitHeavy = {
		Ids = {},
		Volume = 1,
		Pitch = { 0.88, 0.96 },
		Fallback = {
			{
				Id = BUILTIN.Boom,
				Volume = 1.5,
				Pitch = { 1.2, 1.35 },
				Length = 0.55,
				Eq = { 8, 0, 0 },
				Distortion = 0.55,
				Reverb = 0.25,
			},
			{ Id = BUILTIN.Thud, Volume = 1.5, Pitch = { 0.8, 0.9 }, Length = 0.3, Eq = { 10, 0, -10 } },
		},
	},
	Block = {
		Ids = {},
		Volume = 0.75,
		Pitch = { 0.95, 1.08 },
		Fallback = {
			{ Id = BUILTIN.Thud, Volume = 1.3, Pitch = { 1.6, 1.8 }, Length = 0.16, Eq = { 0, 4, -8 } },
			{ Id = BUILTIN.Boom, Volume = 0.45, Pitch = { 3.2, 3.6 }, Length = 0.09, Eq = { -10, 4, 2 } },
		},
	},
	GuardBreak = {
		Ids = {},
		Volume = 1,
		Pitch = { 0.95, 1.02 },
		Fallback = {
			{ Id = BUILTIN.Boom, Volume = 1.3, Pitch = { 1.5, 1.6 }, Length = 0.5, Eq = { 0, 4, 6 }, Distortion = 0.6 },
			{ Id = BUILTIN.Click, Volume = 2, Pitch = { 0.6, 0.65 }, Length = 0.4, Eq = { -10, 0, 8 }, Reverb = 0.6 },
		},
	},
	Parry = {
		Ids = {},
		Volume = 1,
		Pitch = { 0.98, 1.06 },
		Fallback = {
			{
				Id = BUILTIN.Boom,
				Volume = 1,
				Pitch = { 3.4, 3.7 },
				Length = 0.14,
				Eq = { -20, 2, 10 },
				Distortion = 0.3,
			},
			{ Id = BUILTIN.Click, Volume = 3, Pitch = { 1.45, 1.55 }, Length = 0.9, Eq = { -20, 0, 10 }, Reverb = 0.9 },
			{
				Id = BUILTIN.Click,
				Volume = 2.2,
				Pitch = { 2.15, 2.25 },
				Length = 0.7,
				Eq = { -20, 0, 10 },
				Reverb = 0.9,
			},
		},
	},
	HeavyCharge = {
		Ids = {},
		Volume = 0.6,
		Pitch = { 1, 1 },
		Length = 0.55,
		Fallback = {
			{
				Id = BUILTIN.Wind,
				Volume = 1.5,
				Pitch = { 0.75, 0.8 },
				Start = 0.2,
				Length = 0.55,
				Eq = { 4, 0, -4 },
				Rise = 1.9,
			},
		},
	},
	Dodge = {
		Ids = {},
		Volume = 0.6,
		Pitch = { 0.95, 1.08 },
		Fallback = {
			{ Id = BUILTIN.Wind, Volume = 1.6, Pitch = { 1.8, 2.0 }, Start = 0.2, Length = 0.3, Eq = { -24, 0, 4 } },
			{ Id = BUILTIN.Jump, Volume = 0.35, Pitch = { 1.3, 1.4 }, Length = 0.2 },
		},
	},
	SlideStart = {
		Ids = {},
		Volume = 0.7,
		Pitch = { 0.95, 1.05 },
		Fallback = {
			{ Id = BUILTIN.Thud, Volume = 0.9, Pitch = { 1.1, 1.2 }, Length = 0.2, Eq = { 4, 0, -6 } },
			{ Id = BUILTIN.Swim, Volume = 0.8, Pitch = { 1.6, 1.7 }, Length = 0.5, Eq = { -10, 2, 2 } },
		},
	},
	SlideLoop = {
		Ids = {},
		Volume = 0.45,
		Pitch = { 1, 1 },
		Looped = true,
		Fallback = {
			{
				Id = BUILTIN.Steps,
				Volume = 1.2,
				Pitch = { 2.6, 2.6 },
				Eq = { -12, 2, 0 },
				Distortion = 0.5,
				Looped = true,
			},
		},
	},
	Land = {
		Ids = {},
		Volume = 0.6,
		Pitch = { 0.9, 1.05 },
		Fallback = {
			{ Id = BUILTIN.Thud, Volume = 1.1, Pitch = { 0.9, 1.0 }, Length = 0.3 },
		},
	},
	BodySlam = {
		Ids = {},
		Volume = 0.8,
		Pitch = { 0.9, 1.0 },
		Fallback = {
			{ Id = BUILTIN.Thud, Volume = 1.6, Pitch = { 0.7, 0.78 }, Length = 0.4, Eq = { 8, 0, -8 } },
			{ Id = BUILTIN.GetUp, Volume = 0.6, Pitch = { 0.9, 1.0 }, Length = 0.4 },
		},
	},
	SprintWind = {
		Ids = {},
		Volume = 0.3,
		Pitch = { 1, 1 },
		Looped = true,
		Fallback = {
			{ Id = BUILTIN.Wind, Volume = 0.55, Pitch = { 1.1, 1.1 }, Eq = { -18, 0, -4 }, Looped = true },
		},
	},
}
]]></string>
